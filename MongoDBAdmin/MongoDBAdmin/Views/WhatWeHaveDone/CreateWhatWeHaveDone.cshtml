@model MongoDBAdmin.Dto.WhatWeHaveDone.CreateWhatWeHaveDoneDto

@{
    ViewData["Title"] = "Yeni Çalışma Ekle";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Yeni Çalışma Ekle (What We Have Done)</h2>

    <form asp-action="CreateWhatWeHaveDone" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" placeholder="Başlık giriniz" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" placeholder="Açıklama giriniz" required rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Görsel Seç (Cloudinary'ye Yüklenir)</label>
            <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" id="fileImg" onchange="previewImage(this, 'previewImg')" />
            <small class="text-muted">Doğrudan Cloudinary'ye yüklenecektir.</small>
        </div>

        <div class="mb-3">
            <label asp-for="ImageURL" class="form-label">Veya Görsel URL Giriniz (İsteğe Bağlı)</label>
            <input asp-for="ImageURL" class="form-control" placeholder="https://res.cloudinary.com/..." />
        </div>

        <div class="mb-3" id="previewContainer" style="display: none;">
            <label class="form-label font-weight-bold">Seçilen Görsel Önizleme:</label><br />
            <img id="previewImg" src="#" alt="Önizleme" class="img-thumbnail" style="max-height: 120px; object-fit: contain;" />
        </div>

        <button type="submit" class="btn btn-success">Kaydet</button>
        <a href="/WhatWeHaveDone/Index" class="btn btn-secondary">Listeye Dön</a>
    </form>
</div>

<script>
    function previewImage(input, previewId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.getElementById(previewId);
                img.src = e.target.result;
                document.getElementById('previewContainer').style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
