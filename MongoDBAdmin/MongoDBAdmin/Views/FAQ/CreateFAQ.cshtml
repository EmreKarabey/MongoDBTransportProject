@model MongoDBAdmin.Dto.FAQ.CreateFAQDto

@{
	ViewData["Title"] = "Yeni SSS Ekle";
	Layout = "_Layout";
}

<div class="content">
	<div class="container-fluid">

		<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column justify-content-between">
			<div class="flex-grow-1">
				<h4 class="fs-20 fw-bold m-0 text-dark d-flex align-items-center gap-2">
					<i data-feather="plus-circle" class="text-primary" style="width: 24px; height: 24px;"></i>
					Yeni Sıkça Sorulan Soru (FAQ) Ekle
				</h4>
			</div>
			<div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
				<a href="/FAQ/Index" class="btn btn-outline-secondary d-flex align-items-center gap-2 shadow-sm px-3 py-2" style="border-radius: 10px; font-weight: 600;">
					<i data-feather="arrow-left" style="width: 16px; height: 16px;"></i>
					<span>Geri Dön</span>
				</a>
			</div>
		</div>

		@if (TempData["ErrorMessage"] != null)
		{
			<div class="alert alert-danger alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444 !important;">
				<div class="d-flex align-items-center gap-2">
					<i data-feather="alert-circle" class="text-danger flex-shrink-0" style="width: 20px; height: 20px;"></i>
					<span class="fw-semibold fs-14">@TempData["ErrorMessage"]</span>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
			</div>
		}

		<div class="card border-0 shadow-sm" style="border-radius: 16px; background: #ffffff;">
			<div class="card-body p-4">
				<form method="post" action="/FAQ/CreateFAQ">
					<div class="mb-4">
						<label class="form-label fw-bold text-dark fs-14">Soru</label>
						<input type="text" class="form-control" asp-for="Question" placeholder="Örn: Siparişim ne zaman kargoya verilir?" style="border-radius: 10px; padding: 12px; border: 1px solid #e5e7eb;" required>
						<span asp-validation-for="Question" class="text-danger fs-13 mt-1 d-block"></span>
					</div>

					<div class="mb-4">
						<label class="form-label fw-bold text-dark fs-14">Açıklama (Cevap)</label>
						<textarea class="form-control" asp-for="Description" rows="5" placeholder="Cevabı buraya girin..." style="border-radius: 10px; padding: 12px; border: 1px solid #e5e7eb;" required></textarea>
						<span asp-validation-for="Description" class="text-danger fs-13 mt-1 d-block"></span>
					</div>

					<div class="d-flex justify-content-end mt-4">
						@Html.AntiForgeryToken()
						<button type="submit" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-4 py-2" style="border-radius: 10px; font-weight: 600;">
							<i data-feather="save" style="width: 18px; height: 18px;"></i>
							<span>Kaydet</span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			if (typeof feather !== 'undefined') {
				feather.replace();
			}
		});
	</script>
}
