@model EntityLayer.Paginate.Paginate<EntityLayer.Entities.FAQ>

@{
    ViewData["Title"] = "Sıkça Sorulan Sorular (FAQ)";
    Layout = "_Layout";

    var items = Model.Items ?? new List<EntityLayer.Entities.FAQ>();
    var totalCount = items.Count;
    var activeCount = items.Count(x => x.IsActive);
    var passiveCount = totalCount - activeCount;
}

<div class="content">
    <div class="container-fluid">

        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column justify-content-between">
            <div class="flex-grow-1">
                <h4 class="fs-20 fw-bold m-0 text-dark d-flex align-items-center gap-2">
                    <i data-feather="help-circle" class="text-primary" style="width: 24px; height: 24px;"></i>
                    Sıkça Sorulan Sorular (FAQ)
                </h4>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
                <a href="/FAQ/CreateFAQ" class="btn btn-success d-flex align-items-center gap-2 shadow-sm px-3 py-2" style="border-radius: 10px; font-weight: 600;">
                    <i data-feather="plus-circle" style="width: 16px; height: 16px;"></i>
                    <span>Yeni Soru Ekle</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 5px solid #10b981 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="check-circle" class="text-success flex-shrink-0" style="width: 20px; height: 20px;"></i>
                    <span class="fw-semibold fs-14">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- İstatistik Özet Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Toplam Soru</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrTotal">@totalCount</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(37, 99, 235, 0.1); color: #2563eb;">
                                <i data-feather="grid" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Aktif Sorular</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrActive">@activeCount</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i data-feather="check-circle" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Pasif Sorular</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrPassive">@passiveCount</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                <i data-feather="x-circle" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ana Tablo Kartı -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: visible; background: #ffffff;">
            <div class="card-body p-0">
                <div class="table-responsive" style="border-radius: 16px; overflow: visible;">
                    <table class="table table-hover align-middle mb-0" id="dataTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-muted fw-semibold fs-13 text-uppercase ps-4 py-3">Soru</th>
                                <th class="text-muted fw-semibold fs-13 text-uppercase py-3">Açıklama</th>
                                <th class="text-muted fw-semibold fs-13 text-uppercase py-3" style="width: 120px;">Durum (AJAX)</th>
                                <th class="text-muted fw-semibold fs-13 text-uppercase pe-4 py-3 text-end" style="width: 120px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr id="row-@item.FaqId" class="border-bottom">
                                        <td class="ps-4">
                                            <span class="fw-bold text-dark fs-14">@item.Question</span>
                                        </td>
                                        <td>
                                            <span class="text-muted fs-14">
                                                @(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input status-toggle" type="checkbox" role="switch" data-id="@item.FaqId" @(item.IsActive ? "checked" : "")>
                                                <label class="form-check-label status-label">@(item.IsActive ? "Aktif" : "Pasif")</label>
                                            </div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            <a class="btn btn-light btn-sm rounded-circle d-inline-flex align-items-center justify-content-center" href="/FAQ/UpdateFAQ/@item.FaqId" style="width: 32px; height: 32px; border: 1px solid #e5e7eb;">
                                                <i data-feather="edit-2" class="text-primary" style="width: 16px; height: 16px;"></i>
                                            </a>
                                            <button class="btn btn-light btn-sm rounded-circle d-inline-flex align-items-center justify-content-center btn-delete" data-id="@item.FaqId" style="width: 32px; height: 32px; border: 1px solid #e5e7eb;">
                                                <i data-feather="trash-2" class="text-danger" style="width: 16px; height: 16px;"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <h5 class="text-dark fw-bold mb-1">Henüz Kayıt Eklenmemiş</h5>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PaginationPartial", Model)

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            // SignalR Setup
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/SignalRHub")
                .build();

            connection.on("TotalFAQCount", function (count) {
                var el = document.getElementById("signalrTotal");
                if (el) el.innerText = count;
            });

            connection.on("ActiveFAQCount", function (count) {
                var el = document.getElementById("signalrActive");
                if (el) el.innerText = count;
            });

            connection.on("PassiveFAQCount", function (count) {
                var el = document.getElementById("signalrPassive");
                if (el) el.innerText = count;
            });

            connection.start().then(function () {
                connection.invoke("SendFAQStatics");
                setInterval(function () {
                    connection.invoke("SendFAQStatics");
                }, 5000);
            }).catch(function (err) {
                console.error(err.toString());
            });

            // AJAX Delete Setup
            $('.btn-delete').on('click', function () {
                var id = $(this).data('id');
                var row = $('#row-' + id);
                
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kaydı kalıcı olarak silmek istiyorsunuz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/FAQ/DeleteFAQ',
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res.success) {
                                    row.fadeOut(500, function () { $(this).remove(); });
                                    Swal.fire('Silindi!', res.message, 'success');
                                } else {
                                    Swal.fire('Hata!', res.message, 'error');
                                }
                            }
                        });
                    }
                });
            });

            // AJAX Status Change Setup
            $('.status-toggle').on('change', function () {
                var checkbox = $(this);
                var id = checkbox.data('id');
                var label = checkbox.siblings('.status-label');

                $.ajax({
                    url: '/FAQ/ChangeStatus',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            label.text(res.isActive ? 'Aktif' : 'Pasif');
                            const Toast = Swal.mixin({
                              toast: true,
                              position: 'top-end',
                              showConfirmButton: false,
                              timer: 3000,
                              timerProgressBar: true
                            });
                            Toast.fire({ icon: 'success', title: res.message });
                        } else {
                            checkbox.prop('checked', !checkbox.prop('checked')); // revert
                            Swal.fire('Hata!', res.message, 'error');
                        }
                    },
                    error: function() {
                        checkbox.prop('checked', !checkbox.prop('checked')); // revert
                        Swal.fire('Hata!', 'İşlem sırasında bir hata oluştu.', 'error');
                    }
                });
            });
        });
    </script>
}
