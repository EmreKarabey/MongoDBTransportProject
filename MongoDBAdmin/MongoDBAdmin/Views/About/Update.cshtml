@model MongoDBAdmin.Dto.About.UpdateAboutDto
@{
    ViewData["Title"] = "Hakkımızda Güncelle";
}

<div class="container-fluid mt-4">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="text-primary font-weight-bold" style="color: #1e293b !important;">Hakkımızda Güncelle</h2>
            <p class="text-muted">Buradan hakkımızda içeriğini güncelleyebilirsiniz.</p>
        </div>
        <a href="/About/Index" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Listeye Dön</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 10px; border-left: 5px solid #dc2626;">
            <div class="d-flex align-items-center">
                <i class="fa fa-exclamation-triangle me-3" style="font-size: 1.5rem; color: #dc2626;"></i>
                <div>
                    <strong>İşlem Başarısız!</strong><br />
                    @TempData["Error"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Form Alanı (Sol Taraf) -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="font-weight-bold" style="color: #475569;"><i class="fa fa-edit me-2"></i>Hakkımızda Bilgileri</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" action="/About/Update" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AboutId" value="@Model.AboutId" />
                        
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Başlık (Title)</label>
                            <input type="text" class="form-control" name="Title" id="inputTitle" value="@Model.Title" placeholder="Örn: Logistic Transp Hikayemiz" required onkeyup="updatePreview()">
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Açıklama (Description)</label>
                            <textarea class="form-control" name="Description" id="inputDesc" rows="4" placeholder="Hakkımızda detaylarını ve şirket tanıtımını girin..." required onkeyup="updatePreview()">@Model.Description</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Yeni Görsel Seç (Cloudinary'ye Yüklenir)</label>
                            <input type="file" class="form-control" name="ImageFile" id="inputFileImg" accept="image/*" onchange="previewSelectedFile(this)">
                            <small class="text-muted">Görseli değiştirmek istemiyorsanız boş bırakınız. Yeni dosya seçerseniz Cloudinary'ye yüklenecektir.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Görsel URL (Mevcut / Manuel)</label>
                            <input type="text" class="form-control" name="ImageURL" id="inputImg" value="@Model.ImageURL" placeholder="https://site.com/about.jpg" onkeyup="updatePreview()">
                            <small class="text-muted">Mevcut görsel URL'si korunur veya yeni dosya seçildiğinde Cloudinary URL'si ile güncellenir.</small>
                        </div>

                        <!-- Öne Çıkan Maddeler (Articles) -->
                        <div class="mb-4">
                            <label class="form-label font-weight-bold d-flex justify-content-between align-items-center">
                                <span><i class="fa fa-list-check me-1 text-primary"></i> Öne Çıkan Maddeler (İsteğe Bağlı)</span>
                                <small class="text-muted">Vizyon, Misyon, Hizmet Maddeleri</small>
                            </label>
                            
                            <div class="row g-2">
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article" id="inputArt1" value="@Model.Article" placeholder="Madde 1: Örn. Güvenilir Taşımacılık" onkeyup="updatePreview()">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article2" id="inputArt2" value="@Model.Article2" placeholder="Madde 2: Örn. 7/24 Müşteri Desteği" onkeyup="updatePreview()">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article3" id="inputArt3" value="@Model.Article3" placeholder="Madde 3: Örn. Global Geniş Ağ" onkeyup="updatePreview()">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article4" id="inputArt4" value="@Model.Article4" placeholder="Madde 4: Örn. Zamanında Teslimat" onkeyup="updatePreview()">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article5" id="inputArt5" value="@Model.Article5" placeholder="Madde 5 (Opsiyonel)" onkeyup="updatePreview()">
                                </div>
                                <div class="col-md-6 mb-2">
                                    <input type="text" class="form-control form-control-sm article-input" name="Article6" id="inputArt6" value="@Model.Article6" placeholder="Madde 6 (Opsiyonel)" onkeyup="updatePreview()">
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="inputStatus" value="true" @(Model.IsActive ? "checked" : "") onchange="updatePreview()">
                                <label class="form-check-label font-weight-bold ms-2" for="inputStatus">Yayında Olsun (Aktif)</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold" style="border-radius: 8px;">
                            <i class="fa fa-save me-2"></i> Değişiklikleri Kaydet
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Canlı Önizleme Alanı (Sağ Taraf) -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm border-0" style="border-radius: 12px; background-color: #f8fafc; position: sticky; top: 20px;">
                <div class="card-header border-0 pt-4 pb-0" style="background-color: transparent;">
                    <h5 class="font-weight-bold text-center" style="color: #475569;"><i class="fa fa-eye me-2"></i>Canlı Önizleme</h5>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center">
                    
                    <!-- Gerçek Kart Tasarımının Birebir Kopyası -->
                    <div class="card shadow-sm border-0 offer-card position-relative" style="border-radius: 16px; overflow: hidden; width: 100%; max-width: 380px; border: 1px solid #f1f5f9; background-color: #ffffff;">
                        
                        <!-- Durum Rozeti (Badge) -->
                        <div class="position-absolute" style="top: 15px; right: 15px; z-index: 5;">
                            <span id="previewBadge" class="badge" style="background: linear-gradient(45deg, #22c55e, #16a34a); padding: 8px 12px; border-radius: 20px; box-shadow: 0 4px 10px rgba(34,197,94,0.3); font-size: 0.8rem; font-weight: 600;">
                                <i class="fa fa-check-circle me-1"></i> Aktif
                            </span>
                        </div>

                        <div class="card-body p-4 d-flex flex-column" style="position: relative; z-index: 2;">
                            <!-- İkon / Resim Alanı -->
                            <div class="mb-4 mt-3 text-center" style="height: 100px; display: flex; justify-content: center; align-items: center;" id="previewImgContainer">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle default-icon-box" style="width: 80px; height: 80px; background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #2563eb; box-shadow: 0 8px 20px rgba(37,99,235,0.15);">
                                    <i class="fa fa-info-circle fa-2x"></i>
                                </div>
                                <img src="" id="previewImg" class="d-none" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.1));" />
                            </div>
                            
                            <!-- Başlık -->
                            <h4 class="card-title text-center font-weight-bold mb-3" style="color: #0f172a; font-size: 1.3rem;" id="previewTitle">Başlık Örneği</h4>
                            
                            <!-- Açıklama (Satır Sınırlamalı) -->
                            <p class="card-text text-muted text-center flex-grow-1 offer-desc" style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 0;" id="previewDesc">
                                Açıklama metni burada görünecektir. Formu doldurdukça bu alan otomatik olarak güncellenir.
                            </p>

                            <!-- Önizleme Maddeleri -->
                            <div id="previewArticlesContainer" class="mt-3 d-none">
                                <div class="small font-weight-bold text-muted mb-1" style="font-size: 0.75rem;"><i class="fa fa-check-double text-success me-1"></i>MADDELER</div>
                                <ul id="previewArticlesList" class="list-unstyled mb-0 d-flex flex-column gap-1 small text-secondary">
                                </ul>
                            </div>
                        </div>

                        <!-- Hover Overlay - Önizleme Butonları -->
                        <div class="hover-overlay position-absolute top-0 left-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center" style="background: rgba(255, 255, 255, 0.95); z-index: 10; opacity: 0; transition: all 0.3s ease; backdrop-filter: blur(4px);">
                            <h5 class="font-weight-bold mb-4" style="color: #1e293b;">Önizleme İşlemleri</h5>
                            
                            <a href="javascript:void(0)" class="btn btn-lg w-75 mb-3 shadow-sm rounded-pill btn-outline-warning" style="font-weight: 600; border-width: 2px;">
                                <i class="fa fa-ban me-2"></i> Pasife Al
                            </a>
                            
                            <a href="javascript:void(0)" class="btn btn-outline-primary btn-lg w-75 mb-3 shadow-sm rounded-pill" style="font-weight: 600; border-width: 2px;">
                                <i class="fa fa-pen me-2"></i> Düzenle
                            </a>
                            
                            <a href="javascript:void(0)" class="btn btn-outline-danger btn-lg w-75 shadow-sm rounded-pill" style="font-weight: 600; border-width: 2px;">
                                <i class="fa fa-trash me-2"></i> Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nasıl Doldurulmalı Alanı (Alt Kısım) -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0" style="border-radius: 12px; border-left: 5px solid #3b82f6 !important;">
                <div class="card-body p-4">
                    <h5 class="font-weight-bold" style="color: #1e293b;"><i class="fa fa-info-circle text-primary me-2"></i>Nasıl Güncellenmeli?</h5>
                    <div class="row mt-3">
                        <div class="col-md-4 mb-3">
                            <h6 class="font-weight-bold text-dark">1. Başlık (Title)</h6>
                            <p class="text-muted" style="font-size: 0.9rem;">Hakkımızda içeriğinin ana başlığını girin. Örneğin: "Biz Kimiz?", "Şirket Profilimiz" veya "Vizyon & Misyonumuz".</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="font-weight-bold text-dark">2. Açıklama (Description)</h6>
                            <p class="text-muted" style="font-size: 0.9rem;">Şirketinizin tarihçesini, kuruluş amacını ve temel faaliyetlerini anlatan kapsamlı ancak akıcı bir metin yazın.</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <h6 class="font-weight-bold text-dark">3. Öne Çıkan Maddeler & Görsel</h6>
                            <p class="text-muted" style="font-size: 0.9rem;">Şirketinizi öne çıkaran 6 adede kadar madde ekleyebilirsiniz. Görsel için kaliteli bir şirket veya ekip fotoğrafı URL'si kullanın.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Açıklama metni sığdırma (CSS Line Clamp) */
    .offer-desc {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        height: 4.8rem;
    }

    /* Önizleme Kart Hover Efekti */
    .offer-card {
        border: 1px solid #f1f5f9;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03) !important;
    }

    .offer-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.15) !important;
        border-color: #e2e8f0;
    }

    .offer-card .hover-overlay {
        visibility: hidden;
    }

    .offer-card:hover .hover-overlay {
        opacity: 1 !important;
        visibility: visible;
    }
</style>

<script>
    function updatePreview() {
        // Form değerlerini al
        var title = document.getElementById('inputTitle').value;
        var desc = document.getElementById('inputDesc').value;
        var imgUrl = document.getElementById('inputImg').value;
        var isStatus = document.getElementById('inputStatus').checked;

        // DOM elemanları
        var previewTitle = document.getElementById('previewTitle');
        var previewDesc = document.getElementById('previewDesc');
        var previewImg = document.getElementById('previewImg');
        var defaultIconBox = document.querySelector('.default-icon-box');
        var previewBadge = document.getElementById('previewBadge');

        // Başlık güncelle
        previewTitle.innerText = title ? title : "Başlık Örneği";
        
        // Açıklama güncelle
        if (desc) {
            previewDesc.innerText = desc.length > 120 ? desc.substring(0, 120) + "..." : desc;
        } else {
            previewDesc.innerText = "Açıklama metni burada görünecektir. Formu doldurdukça bu alan otomatik olarak güncellenir.";
        }

        // Resim güncelle
        if (imgUrl) {
            previewImg.src = imgUrl;
            previewImg.classList.remove('d-none');
            defaultIconBox.classList.add('d-none');
            defaultIconBox.classList.remove('d-inline-flex');
        } else {
            previewImg.classList.add('d-none');
            defaultIconBox.classList.remove('d-none');
            defaultIconBox.classList.add('d-inline-flex');
        }

        // Durum rozeti güncelle
        if (isStatus) {
            previewBadge.style.background = "linear-gradient(45deg, #22c55e, #16a34a)";
            previewBadge.innerHTML = '<i class="fa fa-check-circle me-1"></i> Aktif';
        } else {
            previewBadge.style.background = "linear-gradient(45deg, #ef4444, #dc2626)";
            previewBadge.innerHTML = '<i class="fa fa-times-circle me-1"></i> Pasif';
        }

        // Maddeleri güncelle
        var articles = [];
        for (var i = 1; i <= 6; i++) {
            var val = document.getElementById('inputArt' + i).value;
            if (val && val.trim().length > 0) {
                articles.push(val.trim());
            }
        }

        var articlesContainer = document.getElementById('previewArticlesContainer');
        var articlesList = document.getElementById('previewArticlesList');
        articlesList.innerHTML = '';

        if (articles.length > 0) {
            articlesContainer.classList.remove('d-none');
            articles.slice(0, 3).forEach(function(item) {
                var li = document.createElement('li');
                li.innerHTML = '<i class="fa fa-check text-success me-1"></i> ' + item;
                articlesList.appendChild(li);
            });
            if (articles.length > 3) {
                var more = document.createElement('li');
                more.className = 'text-muted font-italic';
                more.innerText = '+ ' + (articles.length - 3) + ' madde daha...';
                articlesList.appendChild(more);
            }
        } else {
            articlesContainer.classList.add('d-none');
        }
    }
    
    function previewSelectedFile(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var previewImg = document.getElementById('previewImg');
                var defaultIconBox = document.querySelector('.default-icon-box');
                previewImg.src = e.target.result;
                previewImg.classList.remove('d-none');
                defaultIconBox.classList.add('d-none');
                defaultIconBox.classList.remove('d-inline-flex');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Sayfa yüklendiğinde önizlemeyi başlat
    document.addEventListener("DOMContentLoaded", updatePreview);
</script>
