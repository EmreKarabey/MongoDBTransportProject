@model dynamic

@if (Model != null && Model.TotalPages > 1)
{
    var controller = ViewContext.RouteData.Values["controller"].ToString();
    var action = ViewContext.RouteData.Values["action"].ToString();
    
    <div class="d-flex justify-content-center mt-4 mb-5">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-rounded justify-content-center">
                
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="/@controller/@action?page=@(Model.Page - 1)&size=@Model.Size" aria-label="Önceki">
                        <span aria-hidden="true">&laquo; Önceki</span>
                    </a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.Page == i ? "active" : "")">
                        <a class="page-link" href="/@controller/@action?page=@i&size=@Model.Size">@i</a>
                    </li>
                }

                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/@controller/@action?page=@(Model.Page + 1)&size=@Model.Size" aria-label="Sonraki">
                        <span aria-hidden="true">Sonraki &raquo;</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
}
