
@model UpdateRoleDto

@{
    ViewData["Title"] = "Rol Güncelle";
    Layout = "_Layout";
}

<div class="content">
    <div class="container-fluid">

        <!-- Sayfa Başlığı & Navigasyon -->
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column justify-content-between">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="/Role/Index" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px; border-radius: 10px;" title="Listeye Geri Dön">
                        <i data-feather="arrow-left" style="width: 16px; height: 16px;"></i>
                    </a>
                    <h4 class="fs-20 fw-bold m-0 text-dark d-flex align-items-center gap-2">
                        <i data-feather="edit-3" class="text-warning" style="width: 22px; height: 22px;"></i>
                        Rol Güncelle
                    </h4>
                </div>
                <p class="text-muted fs-13 mb-0 ms-sm-5">Mevcut rolün adını güncelleyin.</p>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
                <ol class="breadcrumb m-0 py-0 me-2 d-none d-md-flex">
                    <li class="breadcrumb-item"><a href="/" class="text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/Role/Index" class="text-muted">Rol Yönetimi</a></li>
                    <li class="breadcrumb-item active text-warning fw-semibold">Rol Güncelle</li>
                </ol>

                <a href="/Role/Index" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2" style="border-radius: 10px; font-weight: 500;">
                    <i data-feather="list" style="width: 15px; height: 15px;"></i>
                    <span>Rol Listesi</span>
                </a>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert"
                 style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="alert-circle" class="text-danger flex-shrink-0" style="width: 20px; height: 20px;"></i>
                    <span class="fw-semibold fs-14">@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- Ana Güncelleme Kartı -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; background: #ffffff;">

                    <div class="card-header bg-white border-bottom p-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm flex-shrink-0"
                                 style="width: 48px; height: 48px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                                <i data-feather="edit-2" style="width: 24px; height: 24px;"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1 fs-16">Rol Düzenleme Formu</h5>
                                <p class="text-muted fs-13 mb-0">Rol adını değiştirerek güncelle butonuna basın.</p>
                            </div>
                        </div>

                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 fs-12">
                            <i data-feather="database" style="width: 13px; height: 13px;" class="me-1"></i>
                            MongoDB Identity
                        </span>
                    </div>

                    <form id="updateRoleForm" method="post" asp-controller="Role" asp-action="UpdateRole">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model?.Id" />

                        <div class="card-body p-4 p-md-5">
                            <div class="row">
                                <div class="col-12 col-md-8 col-lg-7">

                                    <!-- Mevcut Rol Bilgisi -->
                                    @if (Model != null && !string.IsNullOrEmpty(Model.roleName))
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-4 p-3 rounded-3"
                                             style="background: #fffbeb; border: 1px solid #fde68a;">
                                            <i data-feather="info" class="text-warning flex-shrink-0" style="width: 16px; height: 16px;"></i>
                                            <span class="fs-13 text-warning fw-semibold">
                                                Mevcut rol adı: <strong>@Model.roleName</strong>
                                            </span>
                                        </div>
                                    }

                                    <label for="roleName" class="form-label text-dark fw-semibold fs-14 mb-2">
                                        Yeni Rol Adı <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group mb-2">
                                        <span class="input-group-text bg-light border-0 text-muted px-3" style="border-radius: 12px 0 0 12px;">
                                            <i data-feather="tag" style="width: 18px; height: 18px;"></i>
                                        </span>
                                        <input type="text" name="roleName" id="roleName" class="form-control bg-light border-0 fs-14 py-3"
                                               placeholder="Yeni rol adını girin..." value="@Model?.roleName"
                                               required autofocus style="border-radius: 0 12px 12px 0;" />
                                    </div>
                                    <div class="d-flex align-items-center gap-1 text-muted fs-12 mt-2">
                                        <i data-feather="info" style="width: 14px; height: 14px;" class="text-primary flex-shrink-0"></i>
                                        <span>Rol adını değiştirmek sisteme bağlı tüm yetkilendirmeleri etkiler. Dikkatli olun.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top p-4 d-flex align-items-center justify-content-end gap-2" style="border-radius: 0 0 16px 16px;">
                            <a href="/Role/Index" class="btn btn-light px-4 py-2" style="border-radius: 10px; font-weight: 500;">
                                İptal
                            </a>
                            <button type="submit" class="btn btn-warning d-flex align-items-center gap-2 px-4 py-2 shadow-sm text-white" style="border-radius: 10px; font-weight: 600;">
                                <i data-feather="save" style="width: 17px; height: 17px;"></i>
                                <span>Rolü Güncelle</span>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        });
    </script>
}
