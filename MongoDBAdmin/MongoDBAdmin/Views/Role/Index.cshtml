@model List<EntityLayer.Entities.AppRole>
@{
    ViewData["Title"] = "Rol Yönetimi";
    Layout = "_Layout";

    var roles = Model ?? new List<EntityLayer.Entities.AppRole>();
    var totalRoles = roles.Count;
    var systemRoles = roles.Count(r => !string.IsNullOrEmpty(r.Name) && 
        (r.Name.Equals("Admin", StringComparison.OrdinalIgnoreCase) || 
         r.Name.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase)));
    var customRoles = totalRoles - systemRoles;
}

<div class="content">
    <div class="container-fluid">

        <!-- Sayfa Başlığı ve Breadcrumb -->
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column justify-content-between">
            <div class="flex-grow-1">
                <h4 class="fs-20 fw-bold m-0 text-dark d-flex align-items-center gap-2">
                    <i data-feather="shield" class="text-primary" style="width: 24px; height: 24px;"></i>
                    Rol ve Yetki Yönetimi
                </h4>
                <p class="text-muted fs-13 mb-0 mt-1">Sistemdeki kullanıcı rollerini, yetki düzeylerini ve rol bazlı erişim izinlerini yönetin.</p>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
                <ol class="breadcrumb m-0 py-0 me-3 d-none d-md-flex">
                    <li class="breadcrumb-item"><a href="/" class="text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0);" class="text-muted">Kullanıcı & Yetkilendirme</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold">Rol Listesi</li>
                </ol>

                <!-- Rol Ekle Butonu -->
                <a href="/Role/CreateRole" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3 py-2" 
                   style="border-radius: 10px; font-weight: 600;">
                    <i data-feather="plus-circle" style="width: 16px; height: 16px;"></i>
                    <span>Yeni Rol Ekle</span>
                </a>
            </div>
        </div>

        @* Başarı Bildirimi *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 5px solid #10b981 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="check-circle" class="text-success flex-shrink-0" style="width: 20px; height: 20px;"></i>
                    <span class="fw-semibold fs-14">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        @* Hata Bildirimi *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="alert-circle" class="text-danger flex-shrink-0" style="width: 20px; height: 20px;"></i>
                    <span class="fw-semibold fs-14">@TempData["ErrorMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- İstatistik Özet Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Tanımlı Roller</span>
                                <h3 class="fw-bold text-dark mb-0">@totalRoles</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(99, 102, 241, 0.1); color: #6366f1;">
                                <i data-feather="shield" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Sistem & Özel</span>
                            <span class="@(totalRoles > 0 ? "text-primary" : "text-muted") fw-semibold">
                                @(totalRoles > 0 ? $"{totalRoles} Aktif Rol" : "Rol Yok")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Sistem Rolleri</span>
                                <h3 class="fw-bold text-dark mb-0">@systemRoles</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i data-feather="lock" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Temel Çekirdek</span>
                            <span class="badge @(systemRoles > 0 ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-light text-muted")">
                                @(systemRoles > 0 ? $"{systemRoles} Korumalı" : "0 Rol")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Özel Roller</span>
                                <h3 class="fw-bold text-dark mb-0">@customRoles</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i data-feather="award" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Kullanıcı Tanımlı</span>
                            <span class="badge @(customRoles > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted")">
                                @(customRoles > 0 ? $"{customRoles} Özel Rol" : "Özel Rol Yok")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Veri Kaynağı</span>
                                <h3 class="fw-bold text-dark mb-0">MongoDB</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
                                <i data-feather="database" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Koleksiyon: Roles</span>
                            <span class="text-info fw-semibold">Atlas Canlı</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ana Rol Listesi Kartı -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; background: #ffffff; overflow: visible;">
            
            <!-- Arama ve Filtreleme Başlığı -->
            <div class="card-header bg-white border-bottom p-3 p-md-4" style="border-radius: 16px 16px 0 0;">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-12 col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted" style="border-radius: 10px 0 0 10px;">
                                <i data-feather="search" style="width: 17px; height: 17px;"></i>
                            </span>
                            <input type="text" id="roleSearchInput" class="form-control bg-light border-0 fs-13 py-2" placeholder="Rol adı ile filtrele..." style="border-radius: 0 10px 10px 0;">
                        </div>
                    </div>

                    <div class="col-12 col-md-7 d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <label class="text-muted fs-13 fw-semibold mb-0 d-none d-sm-inline">Rol Tipi:</label>
                            
                            <select id="roleTypeFilter" class="form-select form-select-sm bg-light border-0 fs-13 py-2" style="border-radius: 10px; width: auto; min-width: 140px;">
                                <option value="all">Tüm Roller</option>
                                <option value="system">Sistem Rolleri</option>
                                <option value="custom">Özel Roller</option>
                            </select>
                        </div>

                        <button type="button" class="btn btn-light btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 10px;" onclick="resetRoleFilters()">
                            <i data-feather="rotate-cw" style="width: 14px; height: 14px;"></i>
                            <span class="d-none d-sm-inline">Sıfırla</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Rol Tablosu -->
            <div class="card-body p-0">
                <div class="table-responsive" style="min-height: 220px; overflow: visible;">
                    <table class="table table-hover align-middle mb-0" id="rolesTable">
                        <thead class="bg-light bg-opacity-50 text-muted fs-12 text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4 py-3" style="width: 60px;">#</th>
                                <th class="py-3">Rol Adı & Rozet</th>
                                <th class="py-3">Rol ID</th>
                                <th class="text-end pe-4 py-3" style="width: 130px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="fs-13">

                            @if (roles.Count > 0)
                            {
                                int index = 1;
                                var bgGradients = new[] {
                                    "linear-gradient(135deg, #7c3aed, #6d28d9)",
                                    "linear-gradient(135deg, #2563eb, #1d4ed8)",
                                    "linear-gradient(135deg, #0ea5e9, #0284c7)",
                                    "linear-gradient(135deg, #10b981, #059669)",
                                    "linear-gradient(135deg, #f59e0b, #d97706)",
                                    "linear-gradient(135deg, #ec4899, #db2777)"
                                };

                                @foreach (var role in roles)
                                {
                                    var roleName = role.Name ?? "İsimsiz Rol";
                                    var isSystem = string.Equals(roleName, "Admin", StringComparison.OrdinalIgnoreCase) ||
                                                   string.Equals(roleName, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
                                    var avatarBg = bgGradients[(index - 1) % bgGradients.Length];
                                    var roleInitial = !string.IsNullOrWhiteSpace(roleName) ? roleName.Substring(0, Math.Min(2, roleName.Length)).ToUpper() : "R";
                                    var normName = role.NormalizedName ?? roleName.ToUpper();
                                    var roleDesc = isSystem ? "Sistem çekirdek yönetimi ve yetkilendirme erişimi." : $"{roleName} operasyonel erişim ve modül yetki grubu.";
                                    var roleScope = isSystem ? "Tam Yetki (Full Access)" : "Standart Erişim";

                                    <tr class="role-row" data-type="@(isSystem ? "system" : "custom")">
                                        <td class="ps-4 text-muted fw-semibold">@index</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" 
                                                     style="width: 40px; height: 40px; background: @avatarBg; font-size: 14px;">
                                                    @roleInitial
                                                </div>
                                                <div>
                                                    <span class="fw-bold text-dark d-block fs-14">@roleName</span>
                                                    <span class="badge px-2 py-0" style="background: #ede9fe; color: #6d28d9; font-size: 11px;">@normName</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <code class="text-muted bg-light px-2 py-1 rounded fs-12 border" title="@role.Id">
                                                @(role.Id.ToString().Length > 18 ? role.Id.ToString().Substring(0, 18) + "..." : role.Id.ToString())
                                            </code>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm px-2 py-1" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" style="border-radius: 8px;">
                                                    <i data-feather="more-vertical" style="width: 16px; height: 16px;"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: 12px; font-size: 13px; z-index: 1050;">
                                                    <li>
                                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0);" 
                                                            onclick="showRoleDetail('@roleName', '@roleDesc', '@(isSystem ? "Sistem Rolü" : "Özel Rol")', '@role.Id', '@roleScope')">
                                                            <i data-feather="eye" class="text-primary" style="width: 15px; height: 15px;"></i> Detay Görüntüle
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    @if (isSystem)
                                                    {
                                                        <li>
                                                            <span class="dropdown-item text-muted py-2 disabled" style="cursor: not-allowed;">
                                                                <i data-feather="slash" style="width: 15px; height: 15px;"></i> Sistem Rolü Silinemez
                                                            </span>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li>
                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger" href="javascript:void(0);" 
                                                                onclick="confirmDeleteRole('@role.Id', '@roleName')">
                                                                <i data-feather="trash-2" style="width: 15px; height: 15px;"></i> Rolü Sil
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item d-flex align-items-center gap-2 py-2 text-warning" href="/Role/UpdateRole?id=@role.Id">
                                                                <i data-feather="edit-3" style="width: 15px; height: 15px;"></i> Rolü Güncelle
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(99, 102, 241, 0.08); color: #6366f1;">
                                                <i data-feather="shield-off" style="width: 32px; height: 32px;"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-1">Kayıtlı Rol Yok</h5>
                                            <p class="text-muted fs-13 mb-3">Veritabanında henüz listelenecek bir kullanıcı rolü bulunamadı.</p>
                                            <a href="/Role/CreateRole" class="btn btn-primary btn-sm px-3 py-2 d-flex align-items-center gap-2" 
                                               style="border-radius: 10px;">
                                                <i data-feather="plus-circle" style="width: 15px; height: 15px;"></i>
                                                <span>İlk Rolü Tanımla</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tablo Alt Bilgi & Sayfalama -->
            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2" style="border-radius: 0 0 16px 16px;">
                <span class="text-muted fs-13" id="roleTableCountInfo">
                    @(totalRoles > 0 ? $"Toplam {totalRoles} rol listeleniyor" : "Rol yok")
                </span>
                <nav aria-label="Sayfalama">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link" href="javascript:void(0);"><i data-feather="chevron-left" style="width: 14px; height: 14px;"></i></a></li>
                        <li class="page-item active"><a class="page-link" href="javascript:void(0);">1</a></li>
                        <li class="page-item disabled"><a class="page-link" href="javascript:void(0);"><i data-feather="chevron-right" style="width: 14px; height: 14px;"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
</div>

<!-- Yeni Rol Ekle Modalı -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <div class="modal-header border-bottom p-4">
                <div>
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="createRoleModalLabel">
                        <i data-feather="shield" class="text-primary" style="width: 20px; height: 20px;"></i>
                        Yeni Rol Tanımla
                    </h5>
                    <p class="text-muted fs-13 mb-0 mt-1">Sisteme yeni bir yetki rolü ekleyin ve veritabanına kaydedin.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            
            <form method="post" asp-controller="Role" asp-action="CreateRole">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="form-label text-dark fw-semibold fs-13">Rol Adı (Görünen İsim) *</label>
                            <input type="text" name="roleName" class="form-control" placeholder="Örn: Pazarlama Yöneticisi, Editör, Destek" required style="border-radius: 10px;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold fs-13">Rol Açıklaması (Opsiyonel)</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Bu role atanacak kullanıcıların görev tanımı..." style="border-radius: 10px;"></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-dark fw-semibold fs-13 mb-2 d-block">Modül İzinleri ve Yetkiler</label>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="permSlider" checked>
                                        <label class="form-check-label fw-semibold fs-13" for="permSlider">Slider Yönetimi</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="permBrand" checked>
                                        <label class="form-check-label fw-semibold fs-13" for="permBrand">Marka İşlemleri</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="permOffer">
                                        <label class="form-check-label fw-semibold fs-13" for="permOffer">Teklif & Hizmetler</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0 p-3" style="border-radius: 12px;">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="permAbout" checked>
                                        <label class="form-check-label fw-semibold fs-13" for="permAbout">Hakkımızda & İçerik</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="permContact">
                                        <label class="form-check-label fw-semibold fs-13" for="permContact">İletişim Mesajları</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="permUsers">
                                        <label class="form-check-label fw-semibold fs-13 text-danger" for="permUsers">Kullanıcı Yönetimi</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                
                <div class="modal-footer border-top p-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: 10px;">İptal</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm" style="border-radius: 10px;">
                        <i data-feather="check" style="width: 16px; height: 16px;" class="me-1"></i> Rolü Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rol Detay Modalı -->
<div class="modal fade" id="roleDetailModal" tabindex="-1" aria-labelledby="roleDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="roleDetailModalLabel">Rol Yetki Profili</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold shadow mb-3" 
                     id="roleModalAvatar" style="width: 64px; height: 64px; background: linear-gradient(135deg, #7c3aed, #6d28d9); font-size: 24px;">
                    <i data-feather="shield" style="width: 28px; height: 28px;"></i>
                </div>
                <h5 class="fw-bold mb-1 text-dark" id="roleModalName">Rol Adı</h5>
                <p class="text-muted fs-13 mb-3" id="roleModalType">Rol Türü</p>

                <div class="card bg-light border-0 text-start p-3 mb-0" style="border-radius: 12px;">
                    <div class="mb-2 fs-13">
                        <span class="text-muted d-block mb-1">Rol ID (MongoDB):</span>
                        <span class="fw-semibold text-primary font-monospace fs-12 text-break" id="roleModalId">-</span>
                    </div>
                    <div class="fs-13">
                        <span class="text-muted d-block mb-1">Erişim Düzeyi:</span>
                        <span class="fw-semibold text-success" id="roleModalPerms">-</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary w-100 py-2" data-bs-dismiss="modal" style="border-radius: 10px;">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Silme İşlemi için Gizli Form -->
<form id="deleteRoleForm" method="post" asp-controller="Role" asp-action="DeleteRole" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteRoleId" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            const searchInput = document.getElementById('roleSearchInput');
            const typeFilter = document.getElementById('roleTypeFilter');
            const rows = document.querySelectorAll('#rolesTable tbody tr.role-row');

            function filterRoleRows() {
                const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
                const selectedType = typeFilter ? typeFilter.value : 'all';

                let visibleCount = 0;

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const type = row.getAttribute('data-type');

                    const matchesTerm = text.includes(term);
                    const matchesType = selectedType === 'all' || type === selectedType;

                    if (matchesTerm && matchesType) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const countInfo = document.getElementById('roleTableCountInfo');
                if (countInfo) {
                    if (rows.length === 0) {
                        countInfo.innerText = 'Rol yok';
                    } else {
                        countInfo.innerText = `Toplam ${rows.length} rolden ${visibleCount} kayıt listeleniyor`;
                    }
                }
            }

            if (searchInput) searchInput.addEventListener('input', filterRoleRows);
            if (typeFilter) typeFilter.addEventListener('change', filterRoleRows);
        });

        function resetRoleFilters() {
            const searchInput = document.getElementById('roleSearchInput');
            const typeFilter = document.getElementById('roleTypeFilter');
            if (searchInput) searchInput.value = '';
            if (typeFilter) typeFilter.value = 'all';

            const rows = document.querySelectorAll('#rolesTable tbody tr.role-row');
            rows.forEach(r => r.style.display = '');

            const countInfo = document.getElementById('roleTableCountInfo');
            if (countInfo) {
                countInfo.innerText = rows.length > 0 ? `Toplam ${rows.length} rol listeleniyor` : 'Rol yok';
            }
        }

        function showRoleDetail(name, desc, type, id, perms) {
            document.getElementById('roleModalName').innerText = name;
            document.getElementById('roleModalType').innerText = type;
            document.getElementById('roleModalId').innerText = id;
            document.getElementById('roleModalPerms').innerText = perms;

            var modal = new bootstrap.Modal(document.getElementById('roleDetailModal'));
            modal.show();
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        }

        function confirmDeleteRole(roleId, roleName) {
            if (confirm(`'${roleName}' adlı rolü silmek istediğinize emin misiniz?`)) {
                document.getElementById('deleteRoleId').value = roleId;
                document.getElementById('deleteRoleForm').submit();
            }
        }
    </script>
}
