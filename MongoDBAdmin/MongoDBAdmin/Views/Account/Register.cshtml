@model RegisterDto

@{
    bool isInPanel = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = isInPanel ? "Yeni Kullanıcı Ekle" : "Kayıt Ol";
    Layout = isInPanel ? "_Layout" : "~/Views/Shared/_AuthLayout.cshtml";
}

@if (isInPanel)
{
    @* Admin Paneli İçerisindeki Görünüm *@
    <div class="container-fluid mt-4">
        <div class="mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="text-primary font-weight-bold" style="color: #1e293b !important;">
                    <i data-feather="user-plus" class="me-2 text-primary" style="width: 28px; height: 28px;"></i> Yeni Kullanıcı / Yönetici Ekle
                </h2>
                <p class="text-muted">Buradan sisteme yeni bir yönetici veya kullanıcı hesabı tanımlayabilirsiniz.</p>
            </div>
            <a href="/" class="btn btn-secondary shadow-sm"><i data-feather="arrow-left" class="me-1" style="width: 16px; height: 16px;"></i> Dashboard'a Dön</a>
        </div>

        @* Başarı Bildirimi *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 5px solid #10b981 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="check-circle" class="text-success flex-shrink-0" style="width: 22px; height: 22px;"></i>
                    <span class="fw-medium fs-14">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        @* Hata Bildirimi *@
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444 !important;">
                <div class="d-flex align-items-start gap-2">
                    <i data-feather="alert-circle" class="text-danger flex-shrink-0 mt-1" style="width: 20px; height: 20px;"></i>
                    <div class="w-100">
                        <span class="fw-bold d-block mb-1 fs-14">İşlem Başarısız:</span>
                        <ul class="mb-0 ps-3 fs-13" style="line-height: 1.6;">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 14px;">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="font-weight-bold" style="color: #475569;">
                            <i data-feather="id-card" class="me-2 text-primary" style="width: 18px; height: 18px;"></i> Hesap Bilgileri
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-controller="Account" asp-action="Register" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label font-weight-bold">Ad Soyad</label>
                                    <input asp-for="FullName" type="text" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="UserName" class="form-label font-weight-bold">Kullanıcı Adı</label>
                                    <input asp-for="UserName" type="text" class="form-control" placeholder="Örn: ahmetyilmaz" required />
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label font-weight-bold">E-Posta Adresi</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Örn: ahmet@sirketiniz.com" required />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ImageFile" class="form-label font-weight-bold">Profil Fotoğrafı</label>
                                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label font-weight-bold">Şifre</label>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="En az 6 karakter" required />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label font-weight-bold">Şifre Tekrarı</label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Şifrenizi tekrar giriniz" required />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top">
                                <button type="submit" class="btn btn-success px-4 py-2 font-weight-bold shadow-sm">
                                    <i data-feather="check" class="me-1" style="width: 16px; height: 16px;"></i> Kullanıcıyı Kaydet
                                </button>
                                <a href="/" class="btn btn-secondary px-4 py-2">İptal</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Bilgilendirme Kartı -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0" style="border-radius: 14px; background-color: #f8fafc;">
                    <div class="card-body p-4">
                        <h6 class="font-weight-bold text-dark mb-3">
                            <i data-feather="shield" class="text-primary me-2" style="width: 18px; height: 18px;"></i> Yönetici Güvenliği
                        </h6>
                        <p class="text-muted fs-13 mb-3">
                            Yeni kullanıcı oluşturduğunuzda kullanıcı doğrudan sisteme giriş yapabilecektir.
                        </p>
                        <ul class="text-muted fs-13 ps-3 mb-0" style="line-height: 1.8;">
                            <li>Şifrenin en az 6 karakter olması önerilir.</li>
                            <li>Kullanıcı adı benzersiz olmalıdır.</li>
                            <li>E-posta adresi geçerli ve daha önce kullanılmamış olmalıdır.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* Dışarıdan Giriş Yapılmamış Haldeki Bağımsız Kayıt Ekranı *@
    <div class="auth-title-section text-center mb-4">
        <h3 class="fw-bold text-dark fs-22 mb-1">Yeni Yönetici Hesabı 🚀</h3>
        <p class="text-muted fs-14 mb-0">MongoDB yönetim paneline erişim için bilgilerinizi girin.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show p-3 mb-3 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 4px solid #ef4444 !important;">
            <div class="d-flex align-items-center gap-2">
                <i data-feather="alert-circle" style="width: 18px; height: 18px;" class="text-danger flex-shrink-0"></i>
                <span class="fs-13 fw-medium">@ViewBag.ErrorMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show p-3 mb-3 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 4px solid #ef4444 !important;">
            <div class="d-flex align-items-start gap-2">
                <i data-feather="alert-circle" class="text-danger flex-shrink-0 mt-1" style="width: 18px; height: 18px;"></i>
                <div class="w-100">
                    <span class="fs-13 fw-bold d-block mb-1">Kayıt İşlemi Başarısız:</span>
                    <ul class="mb-0 ps-3 fs-13" style="line-height: 1.6;">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <form method="post" asp-controller="Account" asp-action="Register" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="fullName" class="form-label text-dark fw-semibold fs-13 mb-1">Ad Soyad</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="user" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="FullName" type="text" 
                       class="form-control form-control-custom" 
                       id="fullName" 
                       placeholder="Örn: Ahmet Yılmaz" 
                       autocomplete="name" />
            </div>
            <span asp-validation-for="FullName" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label for="username" class="form-label text-dark fw-semibold fs-13 mb-1">Kullanıcı Adı</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="at-sign" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="UserName" type="text" 
                       class="form-control form-control-custom" 
                       id="username" 
                       placeholder="ahmetyilmaz" 
                       autocomplete="username" />
            </div>
            <span asp-validation-for="UserName" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label text-dark fw-semibold fs-13 mb-1">E-Posta Adresi</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="mail" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="Email" type="email" 
                       class="form-control form-control-custom" 
                       id="email" 
                       placeholder="ahmet@sirketiniz.com" 
                       autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label for="imageFile" class="form-label text-dark fw-semibold fs-13 mb-1">Profil Fotoğrafı</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="image" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="ImageFile" type="file" 
                       class="form-control form-control-custom bg-white" 
                       id="imageFile" 
                       accept="image/*" />
            </div>
            <span asp-validation-for="ImageFile" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label text-dark fw-semibold fs-13 mb-1">Şifre</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="lock" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="Password" type="password" 
                       class="form-control form-control-custom input-has-toggle" 
                       id="password" 
                       placeholder="En az 6 karakter" 
                       autocomplete="new-password" />
                <button class="password-toggle-btn" type="button" id="toggleRegPasswordBtn">
                    <i data-feather="eye" style="width: 16px; height: 16px;"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label for="confirmPassword" class="form-label text-dark fw-semibold fs-13 mb-1">Şifre Tekrarı</label>
            <div class="input-group input-group-custom">
                <span class="input-group-text">
                    <i data-feather="check-circle" style="width: 17px; height: 17px;"></i>
                </span>
                <input asp-for="ConfirmPassword" type="password" 
                       class="form-control form-control-custom input-has-toggle" 
                       id="confirmPassword" 
                       placeholder="Şifrenizi tekrar girin" 
                       autocomplete="new-password" />
                <button class="password-toggle-btn" type="button" id="toggleRegConfirmPasswordBtn">
                    <i data-feather="eye" style="width: 16px; height: 16px;"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger fs-12 mt-1 d-block fw-medium"></span>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn btn-gradient-primary d-flex align-items-center justify-content-center gap-2">
                <i data-feather="user-plus" style="width: 18px; height: 18px;"></i>
                <span>Hesap Oluştur</span>
            </button>
        </div>
    </form>

    <div class="text-center mt-3">
        <p class="text-muted fs-14 mb-0">
            Zaten bir hesabınız var mı?
            <a href="/Account/Login" class="text-primary fw-bold text-decoration-none ms-1">
                Giriş Yapın
            </a>
        </p>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
            if (document.getElementById('toggleRegPasswordBtn') && typeof setupPasswordToggle === 'function') {
                setupPasswordToggle('toggleRegPasswordBtn', 'password');
            }
            if (document.getElementById('toggleRegConfirmPasswordBtn') && typeof setupPasswordToggle === 'function') {
                setupPasswordToggle('toggleRegConfirmPasswordBtn', 'confirmPassword');
            }
        });
    </script>
}
