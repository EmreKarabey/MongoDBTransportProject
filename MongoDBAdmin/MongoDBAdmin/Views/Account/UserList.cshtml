@model List<EntityLayer.Entities.AppUser?>
@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "_Layout";

    var users = Model?.Where(u => u != null).Cast<EntityLayer.Entities.AppUser>().ToList() ?? new List<EntityLayer.Entities.AppUser>();
    var totalUsers = users.Count;
    var activeUsers = users.Count(u => !u.LockoutEnd.HasValue || u.LockoutEnd <= DateTimeOffset.UtcNow);
    var lockedUsers = users.Count(u => u.LockoutEnd.HasValue && u.LockoutEnd > DateTimeOffset.UtcNow);
    var confirmedEmails = users.Count(u => u.EmailConfirmed);
}

<div class="content">
    <div class="container-fluid">

        <!-- Sayfa Başlığı ve Breadcrumb -->
        <div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column justify-content-between">
            <div class="flex-grow-1">
                <h4 class="fs-20 fw-bold m-0 text-dark d-flex align-items-center gap-2">
                    <i data-feather="users" class="text-primary" style="width: 24px; height: 24px;"></i>
                    Kullanıcı Yönetimi
                </h4>
                <p class="text-muted fs-13 mb-0 mt-1">Sistemdeki tüm yönetici ve yetkili kullanıcıları görüntüleyin, durum ve erişimlerini yönetin.</p>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
                <ol class="breadcrumb m-0 py-0 me-3 d-none d-md-flex">
                    <li class="breadcrumb-item"><a href="/" class="text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0);" class="text-muted">Kullanıcı Yönetimi</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold">Kullanıcı Listesi</li>
                </ol>

                <a href="/Account/Register" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3 py-2" style="border-radius: 10px; font-weight: 600;">
                    <i data-feather="user-plus" style="width: 16px; height: 16px;"></i>
                    <span>Yeni Kullanıcı Ekle</span>
                </a>
            </div>
        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 5px solid #10b981 !important;">
                <div class="d-flex align-items-center gap-2">
                    <i data-feather="check-circle" class="text-success flex-shrink-0" style="width: 20px; height: 20px;"></i>
                    <span class="fw-semibold fs-14">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        <!-- İstatistik Özet Kartları -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Toplam Kullanıcı</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrTotalUsers">@totalUsers</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(37, 99, 235, 0.1); color: #2563eb;">
                                <i data-feather="users" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Sistem Kayıtları</span>
                            <span class="text-primary fw-semibold">MongoDB Atlas</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Aktif Hesaplar</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrActiveUsers">@activeUsers</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i data-feather="check-circle" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Erişime Açık</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Aktif</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Onaylı E-Posta</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrConfirmedEmails">@confirmedEmails</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(14, 165, 233, 0.1); color: #0ea5e9;">
                                <i data-feather="mail" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Doğrulanmış</span>
                            <span class="text-info fw-semibold">@(totalUsers > 0 ? $"%{(confirmedEmails * 100 / totalUsers)}" : "%0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: #ffffff;">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-13 fw-semibold text-uppercase d-block mb-1">Kilitli / Askıda</span>
                                <h3 class="fw-bold text-dark mb-0" id="signalrLockedUsers">@lockedUsers</h3>
                            </div>
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                <i data-feather="lock" style="width: 22px; height: 22px;"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between fs-12 text-muted">
                            <span>Güvenlik Koruması</span>
                            <span class="badge @(lockedUsers > 0 ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-light text-muted")">
                                @(lockedUsers > 0 ? $"{lockedUsers} Hesap Kilitli" : "Kilitli Yok")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ana Tablo Kartı -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px; overflow: visible; background: #ffffff;">
            
            <!-- Arama & Filtre Kontrolleri -->
            <div class="card-header bg-white border-bottom p-3 p-md-4">
                <div class="row g-3 align-items-center justify-content-between">
                    <div class="col-12 col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 text-muted" style="border-radius: 10px 0 0 10px;">
                                <i data-feather="search" style="width: 17px; height: 17px;"></i>
                            </span>
                            <input type="text" id="userSearchInput" class="form-control bg-light border-0 fs-13 py-2" placeholder="Ad, kullanıcı adı veya e-posta ile ara..." style="border-radius: 0 10px 10px 0;">
                        </div>
                    </div>

                    <div class="col-12 col-md-7 d-flex flex-wrap align-items-center justify-content-md-end gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <label class="text-muted fs-13 fw-semibold mb-0 d-none d-sm-inline">Durum:</label>
                            
                            <!-- Durum Filtresi -->
                            <select id="statusFilter" class="form-select form-select-sm bg-light border-0 fs-13 py-2" style="border-radius: 10px; width: auto; min-width: 130px;">
                                <option value="all">Tüm Durumlar</option>
                                <option value="active">Aktif</option>
                                <option value="locked">Kilitli</option>
                            </select>
                        </div>

                        <button type="button" class="btn btn-light btn-sm px-3 py-2 d-flex align-items-center gap-1" style="border-radius: 10px;" onclick="window.location.reload();">
                            <i data-feather="rotate-cw" style="width: 14px; height: 14px;"></i>
                            <span class="d-none d-sm-inline">Yenile</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Kullanıcı Tablosu -->
            <div class="card-body p-0">
                <div class="table-responsive" style="overflow: visible;">
                    <table class="table table-hover align-middle mb-0" id="usersTable">
                        <thead class="bg-light bg-opacity-50 text-muted fs-12 text-uppercase fw-bold">
                            <tr>
                                <th class="ps-4 py-3" style="width: 60px;">#</th>
                                <th class="py-3">Kullanıcı Bilgileri</th>
                                <th class="py-3">E-Posta</th>
                                <th class="py-3">Yetki / Rol</th>
                                <th class="py-3">Hatalı Giriş</th>
                                <th class="py-3">Durum</th>
                                <th class="text-end pe-4 py-3" style="width: 130px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody class="fs-13">

                            @if (users.Count > 0)
                            {
                                int index = 1;
                                var bgGradients = new[] {
                                    "linear-gradient(135deg, #2563eb, #1d4ed8)",
                                    "linear-gradient(135deg, #0ea5e9, #0284c7)",
                                    "linear-gradient(135deg, #10b981, #059669)",
                                    "linear-gradient(135deg, #f59e0b, #d97706)",
                                    "linear-gradient(135deg, #8b5cf6, #6d28d9)",
                                    "linear-gradient(135deg, #ec4899, #db2777)"
                                };

                                @foreach (var user in users)
                                {
                                    var displayName = !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName;
                                    var initials = !string.IsNullOrWhiteSpace(user.FullName)
                                        ? string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper()
                                        : (!string.IsNullOrWhiteSpace(user.UserName) ? user.UserName.Substring(0, Math.Min(2, user.UserName.Length)).ToUpper() : "U");
                                    if (initials.Length > 2) initials = initials.Substring(0, 2);

                                    var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                                    var avatarBg = bgGradients[(index - 1) % bgGradients.Length];

                                    <tr class="user-row" data-status="@(isLocked ? "locked" : "active")">
                                        <td class="ps-4 text-muted fw-semibold">@index</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(user.ImageURL))
                                                {
                                                    <img src="@user.ImageURL" class="rounded-circle shadow-sm flex-shrink-0" 
                                                         style="width: 42px; height: 42px; object-fit: cover;" alt="user avatar" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" 
                                                         style="width: 42px; height: 42px; background: @avatarBg; font-size: 15px;">
                                                        @initials
                                                    </div>
                                                }
                                                <div>
                                                    <a href="javascript:void(0);" class="fw-bold text-dark text-decoration-none d-block fs-14">
                                                        @displayName
                                                    </a>
                                                    <span class="text-muted fs-12">@@@(user.UserName)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1 text-dark">
                                                <i data-feather="mail" class="text-muted me-1" style="width: 14px; height: 14px;"></i>
                                                <span>@user.Email</span>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <span title="E-Posta Doğrulandı" class="text-success ms-1"><i data-feather="check" style="width: 14px; height: 14px;"></i></span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge px-2 py-1" style="background-color: #ede9fe; color: #6d28d9; border-radius: 8px; font-weight: 600;">
                                                <i data-feather="shield" style="width: 12px; height: 12px;" class="me-1"></i> Yönetici
                                            </span>
                                        </td>
                                        <td>
                                            @if (user.AccessFailedCount > 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1" style="border-radius: 8px;">
                                                    @user.AccessFailedCount deneme
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-12">0 Hata</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isLocked)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="border-radius: 8px;">
                                                    <i data-feather="lock" style="width: 12px; height: 12px;" class="me-1"></i> Kilitli
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius: 8px;">
                                                    <i data-feather="check-circle" style="width: 12px; height: 12px;" class="me-1"></i> Aktif
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm px-2 py-1" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" style="border-radius: 8px;">
                                                    <i data-feather="more-vertical" style="width: 16px; height: 16px;"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: 12px; font-size: 13px;">
                                                    <li>
                                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0);" 
                                                           onclick="showUserDetail('@(displayName)', '@@@(user.UserName)', '@(user.Email)', 'Yönetici', '@(isLocked ? "Kilitli" : "Aktif")', '@(user.Id)', '@(user.EmailConfirmed ? "Onaylı" : "Onaysız")')">
                                                            <i data-feather="eye" class="text-primary" style="width: 15px; height: 15px;"></i> Detay Görüntüle
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0);" onclick="openRoleAssignModal('@user.Id', '@displayName')">
                                                            <i data-feather="shield" class="text-info" style="width: 15px; height: 15px;"></i> Rol Ata
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2" href="javascript:void(0);" onclick="alert('Şifre sıfırlama talimatı kullanıcı e-posta adresine iletildi.')">
                                                            <i data-feather="key" class="text-warning" style="width: 15px; height: 15px;"></i> Şifre Sıfırla
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center justify-content-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background: rgba(37, 99, 235, 0.08); color: #2563eb;">
                                                <i data-feather="users" style="width: 32px; height: 32px;"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-1">Henüz Kayıtlı Kullanıcı Bulunamadı</h5>
                                            <p class="text-muted fs-13 mb-3">Sisteme yeni bir yönetici veya kullanıcı tanımlayarak başlayabilirsiniz.</p>
                                            <a href="/Account/Register" class="btn btn-primary btn-sm px-3 py-2 d-flex align-items-center gap-2" style="border-radius: 10px;">
                                                <i data-feather="user-plus" style="width: 15px; height: 15px;"></i>
                                                <span>İlk Kullanıcıyı Ekle</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tablo Alt Bilgi & Sayfalama -->
            <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span class="text-muted fs-13" id="tableCountInfo">
                    @(totalUsers > 0 ? $"Toplam {totalUsers} kullanıcı listeleniyor" : "Kayıt yok")
                </span>
                <nav aria-label="Sayfalama">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item disabled"><a class="page-link" href="javascript:void(0);"><i data-feather="chevron-left" style="width: 14px; height: 14px;"></i></a></li>
                        <li class="page-item active"><a class="page-link" href="javascript:void(0);">1</a></li>
                        <li class="page-item disabled"><a class="page-link" href="javascript:void(0);"><i data-feather="chevron-right" style="width: 14px; height: 14px;"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
</div>

<!-- Kullanıcı Detay Modalı -->
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-labelledby="userDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="userDetailModalLabel">Kullanıcı Profil Kartı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center fw-bold shadow mb-3" 
                     id="modalAvatar" style="width: 72px; height: 72px; background: linear-gradient(135deg, #2563eb, #1d4ed8); font-size: 26px;">
                    U
                </div>
                <h5 class="fw-bold mb-1 text-dark" id="modalFullName">Kullanıcı Adı</h5>
                <p class="text-muted fs-13 mb-3" id="modalUserName">@@username</p>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    <span class="badge px-3 py-2" id="modalRole" style="background-color: #ede9fe; color: #6d28d9; border-radius: 8px;">Yönetici</span>
                    <span class="badge px-3 py-2" id="modalStatus" style="background-color: #ecfdf5; color: #047857; border-radius: 8px;">Aktif</span>
                </div>

                <div class="card bg-light border-0 text-start p-3 mb-0" style="border-radius: 12px;">
                    <div class="d-flex justify-content-between mb-2 fs-13">
                        <span class="text-muted">Kullanıcı ID:</span>
                        <span class="fw-semibold text-dark font-monospace fs-12" id="modalUserId">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-13">
                        <span class="text-muted">E-Posta:</span>
                        <span class="fw-semibold text-dark" id="modalEmail">email@sirket.com</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-13">
                        <span class="text-muted">E-Posta Onayı:</span>
                        <span class="fw-semibold text-dark" id="modalEmailConfirmed">Onaylı</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-13">
                        <span class="text-muted">Veritabanı Motoru:</span>
                        <span class="fw-semibold text-dark">MongoDB NoSQL</span>
                    </div>
                    <div class="d-flex justify-content-between fs-13">
                        <span class="text-muted">Yetki Seviyesi:</span>
                        <span class="fw-semibold text-success">Admin Paneli Tam Erişim</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary w-100 py-2" data-bs-dismiss="modal" style="border-radius: 10px;">Kapat</button>
            </div>
        </div>
    </div>
</div>

@await Component.InvokeAsync("_UserListRolePartialComponent")

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/SignalRHub")
                .build();

            connection.on("UsersCount", function (count) {
                document.getElementById("signalrTotalUsers").innerText = count;
            });

            connection.on("ActiveUsersCount", function (count) {
                document.getElementById("signalrActiveUsers").innerText = count;
            });

            connection.on("ActiveUsersEmailCount", function (count) {
                document.getElementById("signalrConfirmedEmails").innerText = count;
            });

            connection.on("BannedUsersCount", function (count) {
                document.getElementById("signalrLockedUsers").innerText = count;
            });

            connection.start().then(function () {
                connection.invoke("SendStatics");
                
                setInterval(function () {
                    connection.invoke("SendStatics");
                }, 5000);
            }).catch(function (err) {
                console.error(err.toString());
            });

            // Filtering Logic
            const statusFilter = document.getElementById('statusFilter');
            const rows = document.querySelectorAll('#usersTable tbody tr.user-row');

            function filterRows() {
                const term = searchInput.value.toLowerCase().trim();
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    const status = row.getAttribute('data-status');

                    const matchesTerm = text.includes(term);
                    const matchesStatus = selectedStatus === 'all' || status === selectedStatus;

                    if (matchesTerm && matchesStatus) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const countInfo = document.getElementById('tableCountInfo');
                if (countInfo) {
                    countInfo.innerText = `Toplam ${rows.length} kullanıcıdan ${visibleCount} kayıt gösteriliyor`;
                }
            }

            if (searchInput) searchInput.addEventListener('input', filterRows);
            if (statusFilter) statusFilter.addEventListener('change', filterRows);
        });

        function showUserDetail(fullName, username, email, role, status, userId, emailConfirmed) {
            document.getElementById('modalFullName').innerText = fullName;
            document.getElementById('modalUserName').innerText = username;
            document.getElementById('modalEmail').innerText = email;
            document.getElementById('modalRole').innerText = role;
            document.getElementById('modalStatus').innerText = status;
            document.getElementById('modalUserId').innerText = userId || '-';
            document.getElementById('modalEmailConfirmed').innerText = emailConfirmed || 'Onaylı';
            
            // Baş harfleri al
            const initials = fullName ? fullName.split(' ').filter(n => n.length > 0).map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'U';
            document.getElementById('modalAvatar').innerText = initials || 'U';

            var modal = new bootstrap.Modal(document.getElementById('userDetailModal'));
            modal.show();
        }

        function openRoleAssignModal(userId, userName) {
            document.getElementById('roleAssignUserId').value = userId;
            document.getElementById('roleAssignUserName').innerText = userName;

            var modal = new bootstrap.Modal(document.getElementById('roleAssignModal'));
            modal.show();
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        }
    </script>
}
