<script>
    function openTrackingModal(shipmentId, lastLocation, lastStatus) {
        document.getElementById('modalShipmentId').value = shipmentId;

        // Durum dropdown'ını ayarla
        var statusSelect = document.getElementById('modalStatusSelect');
        statusSelect.selectedIndex = 0; // Önce sıfırla

        if (lastStatus && lastStatus.trim() !== '') {
            for (var i = 0; i < statusSelect.options.length; i++) {
                if (statusSelect.options[i].value === lastStatus.trim()) {
                    statusSelect.selectedIndex = i;
                    break;
                }
            }
        }

        // Konum dropdown'ını ayarla
        var locationSelect = document.getElementById('modalLocationSelect');
        locationSelect.selectedIndex = 0; // Önce sıfırla

        if (lastLocation && lastLocation.trim() !== '') {
            for (var i = 0; i < locationSelect.options.length; i++) {
                if (locationSelect.options[i].value === lastLocation.trim()) {
                    locationSelect.selectedIndex = i;
                    break;
                }
            }
        }

        var myModal = new bootstrap.Modal(document.getElementById('trackingModal'));
        myModal.show();

        // Modal açıldığında yeni ikonları işle
        setTimeout(function() {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        }, 100);
    }
</script>

<!-- SignalR Referansı -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/SignalRHub")
            .build();

        connection.on("ActiveShipment", function (value) {
            document.getElementById("activeShipmentCount").innerText = value;
        });
        
        connection.on("PassiveShipment", function (value) {
            document.getElementById("passiveShipmentCount").innerText = value;
        });

        connection.on("IsBeingPreparedShipment", function (value) {
            document.getElementById("isBeingPreparedShipmentCount").innerText = value;
        });

        connection.on("Shipped", function (value) {
            // "Kargoya Verildi"
            document.getElementById("shippedToCarrierCount").innerText = value;
        });
        
        connection.on("OutForDelivery", function (value) {
            // "Kargo dağıtıma çıkartıldı"
            document.getElementById("shippedCount").innerText = value;
        });

        connection.on("Delivered", function (value) {
            document.getElementById("deliveredCount").innerText = value;
        });

        connection.start().then(function () {
            console.log("SignalR Connected!");
            
            // Başlangıçta ve her 3 saniyede bir dataları çekmek için hub metodunu tetikleyelim
            connection.invoke("SendShipmentStatics");
            setInterval(function () {
                connection.invoke("SendShipmentStatics");
            }, 3000);

        }).catch(function (err) {
            console.error(err.toString());
        });
    });
</script>

