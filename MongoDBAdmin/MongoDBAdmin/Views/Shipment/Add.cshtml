<style>
    .transition-300 {
        transition: all 0.3s ease;
    }
    .custom-input {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        transition: all 0.3s ease;
    }
    .custom-input:focus {
        background-color: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
    }
    .input-group-text {
        border-color: #e2e8f0;
    }
    .save-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.4) !important;
    }
    .ticket-preview {
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .ticket-preview:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.2) !important;
    }
    .ticket-cutout {
        position: absolute;
        bottom: -15px;
        width: 30px;
        height: 30px;
        background-color: #f1f5f9; /* card-body background ile aynı */
        border-radius: 50%;
        z-index: 10;
    }
    .ticket-cutout-left {
        left: -15px;
    }
    .ticket-cutout-right {
        right: -15px;
    }
    .border-dashed {
        border-top: 2px dashed #cbd5e1 !important;
    }
    .airplane-track {
        height: 2px; 
        background: repeating-linear-gradient(to right, #cbd5e1 0, #cbd5e1 6px, transparent 6px, transparent 12px); 
        width: 100%; 
        position: absolute; 
        top: 50%; 
        left: 0; 
        transform: translateY(-50%);
        z-index: 1;
    }
    .flying-airplane {
        position: relative;
        z-index: 2;
        background-color: white;
        padding: 0 5px;
    }
    .ticket-city {
        font-size: 1.5rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const receiverSelect = document.getElementById('ReceiverId');
        const originSelect = document.getElementById('OriginCity');
        const destSelect = document.getElementById('DestinationCity');

        const previewReceiver = document.getElementById('preview-receiver');
        const previewOrigin = document.getElementById('preview-origin');
        const previewDest = document.getElementById('preview-destination');

        function updatePreview() {
            // Receiver (If they split by '|', we get the second part, otherwise just the text)
            if (receiverSelect.selectedIndex > 0) {
                const text = receiverSelect.options[receiverSelect.selectedIndex].text;
                previewReceiver.innerText = text;
            } else {
                previewReceiver.innerText = 'Alıcı Seçilmedi';
            }

            if (originSelect.selectedIndex > 0) {
                previewOrigin.innerText = originSelect.options[originSelect.selectedIndex].text;
            } else {
                previewOrigin.innerText = 'Belirtilmedi';
            }

            if (destSelect.selectedIndex > 0) {
                previewDest.innerText = destSelect.options[destSelect.selectedIndex].text;
            } else {
                previewDest.innerText = 'Belirtilmedi';
            }
        }

        receiverSelect.addEventListener('change', updatePreview);
        originSelect.addEventListener('change', updatePreview);
        destSelect.addEventListener('change', updatePreview);
    });
</script>
