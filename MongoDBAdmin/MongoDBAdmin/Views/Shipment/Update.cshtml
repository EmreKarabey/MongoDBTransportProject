@model MongoDBAdmin.Dto.Shipment.UpdateShipmentDto
@{
    ViewData["Title"] = "Sipariş Güncelle";
}

<div class="container-fluid mt-4">
    <!-- Başlık -->
    <div class="mb-5 d-flex justify-content-between align-items-center flex-wrap gap-3" style="background: linear-gradient(135deg, #0f172a 0%, #4f46e5 100%); padding: 30px; border-radius: 16px; color: white; box-shadow: 0 10px 25px rgba(79, 70, 229, 0.2);">
        <div>
            <h2 class="font-weight-bold mb-2 text-white"><i class="fa fa-edit me-3"></i>Sipariş Güncelle</h2>
            <p class="mb-0" style="color: #e0e7ff; font-size: 1.1rem;">Takip No: <strong>@Model.TrackingNumber</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Shipment/Details/@Model.ShipmentId" class="btn btn-light rounded-pill px-4 py-2 font-weight-bold shadow-sm" style="color: #4f46e5;">
                <i class="fa fa-eye me-2"></i>Detaylar
            </a>
            <a href="/Shipment/Index" class="btn btn-outline-light rounded-pill px-4 py-2 font-weight-bold">
                <i class="fa fa-arrow-left me-2"></i>Listeye Dön
            </a>
        </div>
    </div>

    <form asp-action="Update" asp-controller="Shipment" method="post" id="updateForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ShipmentId" value="@Model.ShipmentId" />
        <input type="hidden" name="TrackingNumber" value="@Model.TrackingNumber" />
        <input type="hidden" name="CreatedDate" value="@Model.CreatedDate.ToString("o")" />
        <input type="hidden" name="SenderName" value="@Model.SenderName" />
        <input type="hidden" name="ReceiverUserId" value="@Model.ReceiverUserId" />
        <input type="hidden" name="ReceiverName" value="@Model.ReceiverName" />
        <input type="hidden" name="CurrentStatus" value="@Model.CurrentStatus" />
        <input type="hidden" name="IsActive" value="@Model.IsActive" />

        <div class="row">
            <!-- FORM ALANI -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden;">
                    <div class="card-header bg-white p-4 border-bottom" style="border-bottom: 2px solid #f1f5f9 !important;">
                        <h4 class="mb-0 text-dark font-weight-bold"><i class="fa fa-clipboard-list me-2 text-primary"></i>Sipariş Bilgileri</h4>
                    </div>
                    <div class="card-body p-5">
                        <!-- Alıcı -->
                        <div class="row mb-5">
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold text-secondary">Gönderici</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa fa-paper-plane text-info"></i></span>
                                    <input type="text" class="form-control border-start-0 custom-input" value="@Model.SenderName" readonly disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold text-secondary">Alıcı</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa fa-user-tag text-success"></i></span>
                                    <input type="text" class="form-control border-start-0 custom-input" value="@Model.ReceiverName" readonly disabled id="ReceiverDisplay" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-5" style="border-color: #e2e8f0; opacity: 1;">

                        <!-- Rota -->
                        <h5 class="font-weight-bold mb-4" style="color: #3b82f6;"><i class="fa fa-route me-2"></i>Rota Bilgileri</h5>
                        <div class="row mb-5">
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold text-secondary">Çıkış Şehri (Nereden)</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa fa-map-marker-alt text-primary"></i></span>
                                    <select id="OriginCity" name="OriginCity" class="form-select border-start-0 custom-input" required>
                                        <option value="" disabled>İl Seçiniz</option>
                                        @{
                                            string[] cities = new[] { "Adana","Adıyaman","Afyonkarahisar","Ağrı","Amasya","Ankara","Antalya","Artvin","Aydın","Balıkesir","Bilecik","Bingöl","Bitlis","Bolu","Burdur","Bursa","Çanakkale","Çankırı","Çorum","Denizli","Diyarbakır","Edirne","Elazığ","Erzincan","Erzurum","Eskişehir","Gaziantep","Giresun","Gümüşhane","Hakkâri","Hatay","Isparta","Mersin","İstanbul","İzmir","Kars","Kastamonu","Kayseri","Kırklareli","Kırşehir","Kocaeli","Konya","Kütahya","Malatya","Manisa","Kahramanmaraş","Mardin","Muğla","Muş","Nevşehir","Niğde","Ordu","Rize","Sakarya","Samsun","Siirt","Sinop","Sivas","Tekirdağ","Tokat","Trabzon","Tunceli","Şanlıurfa","Uşak","Van","Yozgat","Zonguldak","Aksaray","Bayburt","Karaman","Kırıkkale","Batman","Şırnak","Bartın","Ardahan","Iğdır","Yalova","Karabük","Kilis","Osmaniye","Düzce" };
                                        }
                                        @foreach (var city in cities)
                                        {
                                            if (Model.OriginCity == city)
                                            {
                                                <option value="@city" selected="selected">@city</option>
                                            }
                                            else
                                            {
                                                <option value="@city">@city</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4 mt-md-0">
                                <label class="form-label font-weight-bold text-secondary">Varış Şehri (Nereye)</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="fa fa-map-pin text-success"></i></span>
                                    <select id="DestinationCity" name="DestinationCity" class="form-select border-start-0 custom-input" required>
                                        <option value="" disabled>İl Seçiniz</option>
                                        @foreach (var city in cities)
                                        {
                                            if (Model.DestinationCity == city)
                                            {
                                                <option value="@city" selected="selected">@city</option>
                                            }
                                            else
                                            {
                                                <option value="@city">@city</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <hr class="my-5" style="border-color: #e2e8f0; opacity: 1;">

                        <!-- Tracking Yönetimi -->
                        <h5 class="font-weight-bold mb-4" style="color: #10b981;"><i class="fa fa-route me-2"></i>Kargo Takip Kayıtları</h5>
                        
                        <div id="trackingContainer">
                            @if (Model.Trackings != null)
                            {
                                for (int i = 0; i < Model.Trackings.Count; i++)
                                {
                                    var t = Model.Trackings[i];
                                    <div class="tracking-row card border-0 shadow-sm mb-3 position-relative" style="border-radius: 12px; border-left: 4px solid #4f46e5 !important;" data-index="@i">
                                        <div class="card-body p-4">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <span class="badge bg-primary rounded-pill px-3 py-1">Kayıt #@(i + 1)</span>
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 remove-tracking-btn" onclick="removeTracking(this)" title="Bu kaydı sil">
                                                    <i class="fa fa-trash me-1"></i>Sil
                                                </button>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-3">
                                                    <label class="form-label text-muted small fw-bold">Durum</label>
                                                    @{
                                                        var statusOptions = new[] { "Siparişiniz hazırlanıyor", "Kargoya verildi", "Kargo dağıtıma çıkartıldı", "Teslim edildi" };
                                                    }
                                                    <select name="Trackings[@i].TrackingStatus" class="form-select custom-input tracking-status-select" required>
                                                        @foreach (var status in statusOptions)
                                                        {
                                                            if (t.TrackingStatus == status)
                                                            {
                                                                <option value="@status" selected="selected">@status</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@status">@status</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label text-muted small fw-bold">Konum</label>
                                                    <select name="Trackings[@i].Location" class="form-select custom-input tracking-location-select" required>
                                                        <option value="" disabled>İl Seçiniz</option>
                                                        @foreach (var city in cities)
                                                        {
                                                            if (t.Location == city)
                                                            {
                                                                <option value="@city" selected="selected">@city</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@city">@city</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label text-muted small fw-bold">Açıklama</label>
                                                    <input type="text" name="Trackings[@i].Description" value="@t.Description" class="form-control custom-input tracking-desc-input" required />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label text-muted small fw-bold">Tarih</label>
                                                    @{ var eventDateStr = t.EventDate.ToString("yyyy-MM-ddTHH:mm"); }
                                                    <input type="datetime-local" name="Trackings[@i].EventDate" value="@eventDateStr" class="form-control custom-input" required />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Yeni Tracking Ekle Butonu -->
                        <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 shadow-sm w-100 mt-2" onclick="addNewTracking()" style="border-style: dashed; border-width: 2px;">
                            <i class="fa fa-plus-circle me-2"></i>Yeni Takip Kaydı Ekle
                        </button>

                        <hr class="my-5" style="border-color: #e2e8f0; opacity: 1;">

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-end gap-3 mt-2">
                            <a href="/Shipment/Index" class="btn btn-light btn-lg rounded-pill px-5 shadow-sm border" style="font-weight: 600;">İptal</a>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow text-white save-btn" style="background: linear-gradient(135deg, #4f46e5, #3b82f6); border: none; font-weight: 600;">
                                <i class="fa fa-save me-2"></i>Güncelle
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CANLI ÖNİZLEME ALANI -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-lg border-0 position-sticky" style="border-radius: 20px; overflow: hidden; background: linear-gradient(135deg, #ffffff, #f8fafc); top: 20px;">
                    <div class="card-header p-4 border-bottom text-center" style="background-color: #f1f5f9;">
                        <h5 class="mb-0 text-secondary font-weight-bold"><i class="fa fa-eye me-2"></i>Canlı Önizleme</h5>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-center">
                        
                        <div class="ticket-preview p-0 rounded-4 shadow bg-white position-relative overflow-hidden" style="border: none;">
                            <!-- Bilet Üst Kısım -->
                            <div class="ticket-header p-4 text-center text-white position-relative" style="background: linear-gradient(135deg, #4f46e5, #3b82f6);">
                                <div class="ticket-cutout ticket-cutout-left"></div>
                                <div class="ticket-cutout ticket-cutout-right"></div>
                                <i class="fa fa-box-open fa-3x mb-3 text-white" style="filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));"></i>
                                <h4 class="font-weight-bold mb-1 letter-spacing-1 text-uppercase" style="letter-spacing: 2px;">Kargo Bileti</h4>
                                <span class="badge bg-white text-primary rounded-pill px-3 py-1 font-weight-bold" id="preview-date">@Model.CreatedDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <!-- Bilet Alt Kısım -->
                            <div class="ticket-body p-4 position-relative">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="text-start" style="width: 35%;">
                                        <small class="text-muted fw-bold d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">Çıkış</small>
                                        <h3 class="text-dark font-weight-bold mb-0 ticket-city text-truncate" id="preview-origin">@(string.IsNullOrEmpty(Model.OriginCity) ? "---" : Model.OriginCity)</h3>
                                    </div>
                                    <div class="text-center px-2 flex-grow-1 position-relative">
                                        <div class="airplane-track"></div>
                                        <i class="fa fa-plane text-primary flying-airplane fs-4"></i>
                                    </div>
                                    <div class="text-end" style="width: 35%;">
                                        <small class="text-muted fw-bold d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;">Varış</small>
                                        <h3 class="text-dark font-weight-bold mb-0 ticket-city text-truncate" id="preview-destination">@(string.IsNullOrEmpty(Model.DestinationCity) ? "---" : Model.DestinationCity)</h3>
                                    </div>
                                </div>

                                <div class="p-3 rounded-3 mt-4" style="background-color: #f8fafc; border-left: 4px solid #3b82f6;">
                                    <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 1px;"><i class="fa fa-user me-1"></i>Alıcı Bilgisi</small>
                                    <span class="font-weight-bold text-dark fs-5 text-truncate d-block" id="preview-receiver">@Model.ReceiverName</span>
                                </div>
                            </div>
                        </div>

                        <!-- Mini Tracking Preview -->
                        <div class="mt-4">
                            <h6 class="text-muted fw-bold mb-3"><i class="fa fa-list-ul me-2"></i>Takip Özeti</h6>
                            <div id="preview-trackings" class="small">
                                @if (Model.Trackings != null)
                                {
                                    foreach (var t in Model.Trackings.OrderByDescending(x => x.EventDate))
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-2" style="background-color: #f8fafc;">
                                            <i class="fa fa-circle text-primary" style="font-size: 0.4rem;"></i>
                                            <span class="fw-bold">@t.TrackingStatus</span>
                                            <span class="text-muted ms-auto">@t.Location</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .transition-300 {
        transition: all 0.3s ease;
    }
    .custom-input {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        transition: all 0.3s ease;
    }
    .custom-input:focus {
        background-color: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
    }
    .input-group-text {
        border-color: #e2e8f0;
    }
    .save-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.4) !important;
    }
    .ticket-preview {
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .ticket-preview:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.2) !important;
    }
    .ticket-cutout {
        position: absolute;
        bottom: -15px;
        width: 30px;
        height: 30px;
        background-color: #f1f5f9;
        border-radius: 50%;
        z-index: 10;
    }
    .ticket-cutout-left {
        left: -15px;
    }
    .ticket-cutout-right {
        right: -15px;
    }
    .airplane-track {
        height: 2px; 
        background: repeating-linear-gradient(to right, #cbd5e1 0, #cbd5e1 6px, transparent 6px, transparent 12px); 
        width: 100%; 
        position: absolute; 
        top: 50%; 
        left: 0; 
        transform: translateY(-50%);
        z-index: 1;
    }
    .flying-airplane {
        position: relative;
        z-index: 2;
        background-color: white;
        padding: 0 5px;
    }
    .ticket-city {
        font-size: 1.5rem;
    }
    .tracking-row {
        transition: all 0.3s ease;
    }
    .tracking-row:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.1) !important;
    }
    .remove-tracking-btn:hover {
        background-color: #ef4444 !important;
        color: white !important;
        border-color: #ef4444 !important;
    }
</style>

<script>
    // --- Tracking Yönetimi ---
    var trackingIndex = @(Model.Trackings?.Count ?? 0);

    var cityOptions = ["Adana","Adıyaman","Afyonkarahisar","Ağrı","Amasya","Ankara","Antalya","Artvin","Aydın","Balıkesir","Bilecik","Bingöl","Bitlis","Bolu","Burdur","Bursa","Çanakkale","Çankırı","Çorum","Denizli","Diyarbakır","Edirne","Elazığ","Erzincan","Erzurum","Eskişehir","Gaziantep","Giresun","Gümüşhane","Hakkâri","Hatay","Isparta","Mersin","İstanbul","İzmir","Kars","Kastamonu","Kayseri","Kırklareli","Kırşehir","Kocaeli","Konya","Kütahya","Malatya","Manisa","Kahramanmaraş","Mardin","Muğla","Muş","Nevşehir","Niğde","Ordu","Rize","Sakarya","Samsun","Siirt","Sinop","Sivas","Tekirdağ","Tokat","Trabzon","Tunceli","Şanlıurfa","Uşak","Van","Yozgat","Zonguldak","Aksaray","Bayburt","Karaman","Kırıkkale","Batman","Şırnak","Bartın","Ardahan","Iğdır","Yalova","Karabük","Kilis","Osmaniye","Düzce"];

    function addNewTracking() {
        var container = document.getElementById('trackingContainer');
        var idx = trackingIndex;

        var cityOptionHtml = '<option value="" disabled>İl Seçiniz</option>';
        for (var c = 0; c < cityOptions.length; c++) {
            cityOptionHtml += '<option value="' + cityOptions[c] + '">' + cityOptions[c] + '</option>';
        }

        var now = new Date();
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        var nowStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());

        var html = '<div class="tracking-row card border-0 shadow-sm mb-3 position-relative" style="border-radius: 12px; border-left: 4px solid #10b981 !important; animation: slideIn 0.3s ease;" data-index="' + idx + '">' +
            '<div class="card-body p-4">' +
            '<div class="d-flex justify-content-between align-items-center mb-3">' +
            '<span class="badge bg-success rounded-pill px-3 py-1">Yeni Kayıt #' + (idx + 1) + '</span>' +
            '<button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 remove-tracking-btn" onclick="removeTracking(this)" title="Bu kaydı sil"><i class="fa fa-trash me-1"></i>Sil</button>' +
            '</div>' +
            '<div class="row g-3">' +
            '<div class="col-md-3"><label class="form-label text-muted small fw-bold">Durum</label>' +
            '<select name="Trackings[' + idx + '].TrackingStatus" class="form-select custom-input tracking-status-select" required>' +
            '<option value="Siparişiniz hazırlanıyor">Siparişiniz hazırlanıyor</option>' +
            '<option value="Kargoya verildi">Kargoya verildi</option>' +
            '<option value="Kargo dağıtıma çıkartıldı">Kargo dağıtıma çıkartıldı</option>' +
            '<option value="Teslim edildi">Teslim edildi</option>' +
            '</select></div>' +
            '<div class="col-md-3"><label class="form-label text-muted small fw-bold">Konum</label>' +
            '<select name="Trackings[' + idx + '].Location" class="form-select custom-input tracking-location-select" required>' + cityOptionHtml + '</select></div>' +
            '<div class="col-md-3"><label class="form-label text-muted small fw-bold">Açıklama</label>' +
            '<input type="text" name="Trackings[' + idx + '].Description" class="form-control custom-input tracking-desc-input" required /></div>' +
            '<div class="col-md-3"><label class="form-label text-muted small fw-bold">Tarih</label>' +
            '<input type="datetime-local" name="Trackings[' + idx + '].EventDate" value="' + nowStr + '" class="form-control custom-input" required /></div>' +
            '</div></div></div>';

        container.insertAdjacentHTML('beforeend', html);
        trackingIndex++;
        reindexTrackings();
        updateTrackingPreview();
    }

    function removeTracking(btn) {
        if (!confirm('Bu takip kaydını silmek istediğinize emin misiniz?\nBu işlem geri alınamaz!')) {
            return;
        }

        var row = btn.closest('.tracking-row');
        var index = parseInt(row.getAttribute('data-index'));
        var shipmentId = document.getElementById('modalShipmentId') ? 
            document.getElementById('modalShipmentId').value : 
            document.querySelector('input[name="ShipmentId"]').value;

        // Sil butonunu devre dışı bırak
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Siliniyor...';

        fetch('/Shipment/DeleteTracking', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({
                shipmentId: shipmentId,
                trackingIndex: index
            })
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                // Başarılı — animasyonla DOM'dan kaldır
                row.style.transform = 'translateX(-100%)';
                row.style.opacity = '0';
                setTimeout(function() {
                    row.remove();
                    reindexTrackings();
                    updateTrackingPreview();
                }, 300);
            } else {
                alert('Hata: ' + data.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-trash me-1"></i>Sil';
            }
        })
        .catch(function(err) {
            alert('Bir hata oluştu: ' + err);
            btn.disabled = false;
            btn.innerHTML = '<i class="fa fa-trash me-1"></i>Sil';
        });
    }

    function reindexTrackings() {
        var rows = document.querySelectorAll('#trackingContainer .tracking-row');
        rows.forEach(function(row, i) {
            row.setAttribute('data-index', i);
            var selects = row.querySelectorAll('select, input');
            selects.forEach(function(el) {
                var name = el.getAttribute('name');
                if (name) {
                    el.setAttribute('name', name.replace(/Trackings\[\d+\]/, 'Trackings[' + i + ']'));
                }
            });
        });
        trackingIndex = rows.length;
    }

    function updateTrackingPreview() {
        var previewDiv = document.getElementById('preview-trackings');
        var rows = document.querySelectorAll('#trackingContainer .tracking-row');
        var html = '';
        
        rows.forEach(function(row) {
            var statusSelect = row.querySelector('.tracking-status-select');
            var locationSelect = row.querySelector('.tracking-location-select');
            var status = statusSelect ? statusSelect.options[statusSelect.selectedIndex].text : '';
            var location = locationSelect && locationSelect.selectedIndex > 0 ? locationSelect.options[locationSelect.selectedIndex].text : '';
            
            html += '<div class="d-flex align-items-center gap-2 mb-2 p-2 rounded-2" style="background-color: #f8fafc;">' +
                '<i class="fa fa-circle text-primary" style="font-size: 0.4rem;"></i>' +
                '<span class="fw-bold">' + status + '</span>' +
                '<span class="text-muted ms-auto">' + location + '</span>' +
                '</div>';
        });

        previewDiv.innerHTML = html || '<div class="text-center text-muted py-2">Takip kaydı yok</div>';
    }

    // --- Canlı Önizleme ---
    document.addEventListener('DOMContentLoaded', function() {
        var originSelect = document.getElementById('OriginCity');
        var destSelect = document.getElementById('DestinationCity');
        var previewOrigin = document.getElementById('preview-origin');
        var previewDest = document.getElementById('preview-destination');

        function updateCityPreview() {
            if (originSelect.selectedIndex > 0) {
                previewOrigin.innerText = originSelect.options[originSelect.selectedIndex].text;
            } else {
                previewOrigin.innerText = '---';
            }
            if (destSelect.selectedIndex > 0) {
                previewDest.innerText = destSelect.options[destSelect.selectedIndex].text;
            } else {
                previewDest.innerText = '---';
            }
        }

        originSelect.addEventListener('change', updateCityPreview);
        destSelect.addEventListener('change', updateCityPreview);

        // Tracking değişikliklerini dinle
        document.getElementById('trackingContainer').addEventListener('change', function() {
            updateTrackingPreview();
        });
    });
</script>

<style>
    @@keyframes slideIn {
        from { transform: translateY(-10px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>
