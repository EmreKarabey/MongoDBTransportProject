@model Paginate<GetListSliderDto>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	/* Banner yazılarının açık arka planlarda okunabilirliğini artır */
	.banner-1 {
		position: relative;
	}

	.banner-1::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			135deg,
			rgba(0, 0, 0, 0.65) 0%,
			rgba(0, 0, 0, 0.35) 50%,
			rgba(0, 0, 0, 0.1) 100%
		);
		z-index: 1;
	}

	.banner-1 .container {
		position: relative;
		z-index: 2;
	}

	.banner-1 h1.color-white,
	.banner-1 p.color-white {
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7), 0 1px 3px rgba(0, 0, 0, 0.5);
	}

	.banner-1 .btn-play {
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
	}

	html {
		scroll-behavior: smooth;
	}

	#kargo-hesapla {
		scroll-margin-top: 120px; /* sabit menünün formun üstünü kapatmaması için */
	}

</style>

<section class="section d-block" id="anasayfa">
	<div class="box-swiper">
		<div class="swiper-container swiper-group-1 swiper-banner-1">
			<div class="swiper-wrapper">
				@foreach (var item in Model.List)
				{
					<div class="swiper-slide">
						<div class="banner-1" style="background-image:url(@Html.Raw(item.ImageURL))">
							<div class="container">
								<div class="row align-items-center">
									<div class="col-lg-12">
										<p class="font-md color-white mb-15">@item.Title</p>
										<h1 class="color-white mb-25">@item.SubTitle<br class="d-none d-lg-block">Logistic Company</h1>
										<div class="row">
											<div class="col-lg-6">
												<p class="font-md color-white mb-20">@item.Description</p>
											</div>
										</div>
										<div class="box-button mt-30"><a class="btn btn-brand-1-big hover-up mr-40" href="#kargo-hesapla">Fiyat Hesapla</a><a class="btn btn-play popup-youtube hover-up" href="https://www.youtube.com/watch?v=kCGf5uNE13I"><img src="~/templates/assets/imgs/template/icons/play.svg" alt="">Süreç Nasıl İşler?</a></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				}


			</div>
			<div class="swiper-pagination swiper-pagination-banner"></div>
		</div>
	</div>
</section>

@await Component.InvokeAsync("_BrandListPartialComponent")

@await Component.InvokeAsync("_OfferListPartialComponent")
@await Component.InvokeAsync("_AboutPartialComponent")
@await Component.InvokeAsync("_GetInTouchPartialComponent")
@await Component.InvokeAsync("_HowItWorksPartialComponent")
@await Component.InvokeAsync("_CommentListPartialComponent")
@await Component.InvokeAsync("_WhatWeHaveDonePartialComponent")
@await Component.InvokeAsync("_FAQListPartialComponent")
@await Component.InvokeAsync("_StaticsPartialComponent")



