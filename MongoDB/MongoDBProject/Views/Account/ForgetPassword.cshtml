@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="msapplication-TileColor" content="#0E0E0E">
    <meta name="template-color" content="#0E0E0E">
    <meta name="description" content="Şifremi Unuttum">
    <meta name="keywords" content="şifremi unuttum, forgot password, reset password">
    <meta name="author" content="">
    <link rel="shortcut icon" type="image/x-icon" href="~/templates/assets/imgs/template/favicon.svg">
    <link href="~/templates/assets/css/style.css?v=3.0.0" rel="stylesheet">
    <title>Şifremi Unuttum</title>
    <style>
      html, body {
        height: 100vh !important;
        max-height: 100vh !important;
        width: 100vw !important;
        max-width: 100vw !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      /* Tüm tarayıcılarda kaydırma çubuklarını (scrollbar) tamamen kaldır */
      ::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
      * {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
      }

      .main {
        height: 100vh !important;
        max-height: 100vh !important;
        overflow: hidden !important;
      }

      .section.box-login {
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
      }

      .box-login-right {
        height: 100vh !important;
        max-height: 100vh !important;
      }

      .box-login-left {
        max-height: 96vh !important;
        overflow-y: auto !important;
        padding: 15px 0 !important;
      }

      .text-danger { color: #dc3545; }
      
      .icon-lock-badge {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: rgba(255, 114, 94, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        box-shadow: 0 8px 20px rgba(255, 114, 94, 0.12);
        transition: transform 0.3s ease;
      }
      .icon-lock-badge:hover {
        transform: translateY(-2px);
      }
      .icon-lock-badge svg {
        width: 28px;
        height: 28px;
        stroke: #FF5D47;
      }

      .info-notice-box {
        background: #F8F9FA;
        border: 1px solid #ECEFF2;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
      }
      .info-notice-box p {
        margin: 0;
        font-size: 13px;
        color: #6C757D;
        line-height: 1.6;
      }

      .input-icon-group {
        position: relative;
      }
      .input-icon-group .icon-inside {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #9AA3AC;
        display: flex;
        align-items: center;
        pointer-events: none;
      }
      .input-icon-group .form-control {
        padding-left: 52px;
        height: 50px;
        border-radius: 10px;
        transition: all 0.25s ease;
      }
      .input-icon-group .form-control:focus {
        border-color: #0E0E0E;
        box-shadow: 0 0 0 4px rgba(14, 14, 14, 0.08);
      }

      .btn-submit-reset {
        width: 100%;
        height: 50px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.3px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
      }
      .btn-submit-reset:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      }

      .back-to-login {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #505A69;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .back-to-login:hover {
        color: #0E0E0E;
        transform: translateX(-3px);
      }

      .secure-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 25px;
        padding-top: 18px;
        border-top: 1px dashed #E2E6EC;
        color: #9AA3AC;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div id="preloader-active">
      <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
          <div class="flip-square"></div>
        </div>
      </div>
    </div>
    
    <main class="main">
      <section class="section box-login">
        <div class="row align-items-center m-0 w-100" style="height: 100vh;"> 
          <div class="col-lg-6">
            <div class="box-login-left">
              
              <!-- Kilit / Güvenlik İkonu -->
              <div class="icon-lock-badge">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </div>

              <h2 class="color-brand-2 mb-10">Şifrenizi mi Unuttunuz?</h2>
              <p class="font-md color-grey-500 mb-25">
                Hiç problem değil! Hesabınıza bağlı e-posta adresinizi yazın, size şifrenizi yenilemeniz için <strong>2 dakika geçerli</strong> bir doğrulama kodu gönderelim.
              </p>

              <!-- Başarı Mesajı -->
              @if (TempData["SuccessMessage"] != null)
              {
                <div class="alert alert-success font-sm mb-20" style="background-color: #E8F5E9; border: 1px solid #A5D6A7; color: #2E7D32; padding: 14px 18px; border-radius: 10px; display: flex; align-items: center; gap: 10px;">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>@TempData["SuccessMessage"]</span>
                </div>
              }

              <!-- Hata Mesajları -->
              @if (!ViewData.ModelState.IsValid)
              {
                <div asp-validation-summary="All" class="alert alert-danger font-sm mb-20" style="background-color: #FFEBEE; border: 1px solid #FFCDD2; color: #C62828; padding: 14px 18px; border-radius: 10px;"></div>
              }

              <!-- Bilgilendirme Kutusu -->
              <div class="info-notice-box">
                <p>
                  ⏱ <strong>Önemli:</strong> Gönderilecek doğrulama kodu <strong>2 dakika</strong> boyunca geçerlidir. E-posta birkaç saniye içinde gelen kutunuza veya spam klasörünüze ulaşacaktır.
                </p>
              </div>
              
              <div class="box-form-login">
                <form asp-action="ForgetPassword" asp-controller="Account" method="post"> 
                  
                  <div class="form-group mb-20"> 
                    <label class="font-xs color-grey-900 d-block mb-10" style="font-weight: 600;">Kayıtlı E-Posta Adresiniz</label>
                    <div class="input-icon-group">
                      <div class="icon-inside">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                      </div>
                      <input class="form-control" type="email" name="Email" id="Email" placeholder="ornek@alanadi.com" required autocomplete="email">
                    </div>
                  </div>
                  @Html.AntiForgeryToken()
                  <div class="form-group mt-25"> 
                    <button class="btn btn-brand-1-big btn-submit-reset" type="submit">
                      <span>Doğrulama Kodu Gönder</span>
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </button>
                  </div>

                  <div class="text-center mt-25">
                    <a class="back-to-login" href="/Account/Login">
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                      </svg>
                      <span>Giriş Sayfasına Geri Dön</span>
                    </a>
                  </div>

                  <div class="secure-badge">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                    <span>256-Bit SSL ile Uçtan Uca Güvenli Şifre Yenileme</span>
                  </div>

                </form>
              </div>
            </div>
          </div>
          
          <div class="col-lg-6">
            <div class="box-login-right">
              <div class="quote-shape shape-1"></div>
              <div class="box-info-bottom-img box-info-bottom-img-3"> 
                <div class="image-play"><img class="mb-15" src="~/templates/assets/imgs/template/icons/play.svg" alt="transp"></div>
                <div class="info-play"> 
                  <h4 class="color-white mb-15">Güvenliğiniz Önceliğimizdir</h4>
                  <p class="font-sm color-white">Hesap ve veri güvenliğinizi korumak için en modern şifreleme ve doğrulama standartlarını uyguluyoruz.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    
    <script src="~/templates/assets/js/vendors/modernizr-3.6.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery-migrate-3.3.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="~/templates/assets/js/vendors/waypoints.js"></script>
    <script src="~/templates/assets/js/vendors/wow.js"></script>
    <script src="~/templates/assets/js/vendors/magnific-popup.js"></script>
    <script src="~/templates/assets/js/vendors/perfect-scrollbar.min.js"></script>
    <script src="~/templates/assets/js/vendors/select2.min.js"></script>
    <script src="~/templates/assets/js/vendors/isotope.js"></script>
    <script src="~/templates/assets/js/vendors/scrollup.js"></script>
    <script src="~/templates/assets/js/vendors/swiper-bundle.min.js"></script>
    <script src="~/templates/assets/js/vendors/noUISlider.js"></script>
    <script src="~/templates/assets/js/vendors/slider.js"></script>
    <script src="~/templates/assets/js/vendors/counterup.js"></script>
    <script src="~/templates/assets/js/vendors/jquery.countdown.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery.elevatezoom.js"></script>
    <script src="~/templates/assets/js/vendors/slick.js"></script>
    <script src="~/templates/assets/js/main.js?v=3.0.0"></script>
  </body>
</html>