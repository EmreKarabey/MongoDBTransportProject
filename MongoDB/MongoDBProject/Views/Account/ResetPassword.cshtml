@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <meta name="msapplication-TileColor" content="#0E0E0E">
    <meta name="template-color" content="#0E0E0E">
    <meta name="description" content="Şifre Sıfırlama">
    <meta name="keywords" content="şifre sıfırlama, reset password">
    <meta name="author" content="">
    <link rel="shortcut icon" type="image/x-icon" href="~/templates/assets/imgs/template/favicon.svg">
    <link href="~/templates/assets/css/style.css?v=3.0.0" rel="stylesheet">
    <title>Yeni Şifre Belirleme</title>
    <style>
      html, body {
        height: 100vh !important;
        max-height: 100vh !important;
        width: 100vw !important;
        max-width: 100vw !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      /* Tüm tarayıcılarda kaydırma çubuklarını (scrollbar) tamamen kaldır */
      ::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
      * {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
      }

      .main {
        height: 100vh !important;
        max-height: 100vh !important;
        overflow: hidden !important;
      }

      .section.box-login {
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: hidden !important;
        display: flex !important;
        align-items: center !important;
      }

      .box-login-right {
        height: 100vh !important;
        max-height: 100vh !important;
      }

      .box-login-left {
        max-height: 96vh !important;
        overflow-y: auto !important;
        padding: 15px 0 !important;
      }

      .text-danger { color: #dc3545; }
      
      .icon-key-badge {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: rgba(255, 114, 94, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        box-shadow: 0 8px 20px rgba(255, 114, 94, 0.12);
        transition: transform 0.3s ease;
      }
      .icon-key-badge:hover {
        transform: translateY(-2px);
      }
      .icon-key-badge svg {
        width: 26px;
        height: 26px;
        stroke: #FF5D47;
      }

      .timer-badge-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #FFF9F5;
        border: 1px solid #FFE4D6;
        border-radius: 10px;
        padding: 10px 16px;
        margin-bottom: 16px;
      }
      .timer-badge-container .timer-text {
        font-size: 13px;
        color: #7A3E2D;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .timer-badge-container .timer-countdown {
        font-size: 15px;
        font-weight: 700;
        color: #FF5D47;
        font-family: monospace;
        background: #FFFFFF;
        padding: 3px 8px;
        border-radius: 6px;
        border: 1px solid #FFD3C2;
      }

      .input-icon-group {
        position: relative;
      }
      .input-icon-group .icon-inside {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #9AA3AC;
        display: flex;
        align-items: center;
        pointer-events: none;
      }
      .input-icon-group .form-control {
        padding-left: 52px;
        height: 46px;
        border-radius: 10px;
        transition: all 0.25s ease;
      }
      .input-icon-group .form-control:focus {
        border-color: #0E0E0E;
        box-shadow: 0 0 0 4px rgba(14, 14, 14, 0.08);
      }

      .input-code {
        letter-spacing: 6px;
        font-weight: 700;
        text-align: center;
        font-size: 18px;
        padding-left: 18px !important;
      }

      .btn-submit-reset {
        width: 100%;
        height: 48px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.3px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
      }
      .btn-submit-reset:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
      }

      .back-to-login {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #505A69;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .back-to-login:hover {
        color: #0E0E0E;
        transform: translateX(-3px);
      }

      .secure-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px dashed #E2E6EC;
        color: #9AA3AC;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div id="preloader-active">
      <div class="preloader d-flex align-items-center justify-content-center">
        <div class="preloader-inner position-relative">
          <div class="flip-square"></div>
        </div>
      </div>
    </div>
    
    <main class="main">
      <section class="section box-login">
        <div class="row align-items-center m-0 w-100" style="height: 100vh;"> 
          <div class="col-lg-6">
            <div class="box-login-left">
              
              <!-- Anahtar / Kilit İkonu -->
              <div class="icon-key-badge">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                </svg>
              </div>

              <h2 class="color-brand-2 mb-10">Yeni Şifrenizi Belirleyin</h2>
              <p class="font-md color-grey-500 mb-20">
                E-posta adresinize gönderilen 6 haneli doğrulama kodunu ve kullanmak istediğiniz yeni şifrenizi giriniz.
              </p>

              <!-- Başarı Mesajı -->
              @if (TempData["SuccessMessage"] != null)
              {
                <div class="alert alert-success font-sm mb-20" style="background-color: #E8F5E9; border: 1px solid #A5D6A7; color: #2E7D32; padding: 12px 16px; border-radius: 10px; display: flex; align-items: center; gap: 10px;">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>@TempData["SuccessMessage"]</span>
                </div>
              }

              <!-- Hata Mesajları -->
              @if (!ViewData.ModelState.IsValid)
              {
                <div asp-validation-summary="All" class="alert alert-danger font-sm mb-20" style="background-color: #FFEBEE; border: 1px solid #FFCDD2; color: #C62828; padding: 12px 16px; border-radius: 10px;"></div>
              }

              <!-- 2 Dakikalık Geri Sayım Rozeti -->
              <div class="timer-badge-container">
                <div class="timer-text">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Kalan Kod Geçerlilik Süresi:</span>
                </div>
                <div class="timer-countdown" id="countdownTimer">02:00</div>
              </div>
              
              <div class="box-form-login">
                <form asp-action="ResetPassword" asp-controller="Account" method="post"> 
                  
                  <!-- E-Posta Alanı -->
                  <div class="form-group mb-15"> 
                    <label class="font-xs color-grey-900 d-block mb-8" style="font-weight: 600;">E-Posta Adresiniz</label>
                    <div class="input-icon-group">
                      <div class="icon-inside">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                      </div>
                      <input class="form-control" type="email" name="Email" id="Email" value="@ViewBag.Email" placeholder="ornek@alanadi.com" required @(ViewBag.Email != null ? "readonly" : "")>
                    </div>
                  </div>

                  <!-- 6 Haneli Doğrulama Kodu Alanı -->
                  <div class="form-group mb-15"> 
                    <label class="font-xs color-grey-900 d-block mb-8" style="font-weight: 600;">6 Haneli Doğrulama Kodu</label>
                    <div class="input-icon-group">
                      <input class="form-control input-code" type="text" name="Code" id="Code" placeholder="123456" maxlength="6" required autocomplete="one-time-code">
                    </div>
                  </div>
                  
                  <!-- Yeni Şifre -->
                  <div class="form-group mb-15"> 
                    <label class="font-xs color-grey-900 d-block mb-8" style="font-weight: 600;">Yeni Şifreniz</label>
                    <div class="input-icon-group">
                      <div class="icon-inside">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                        </svg>
                      </div>
                      <input class="form-control" type="password" name="NewPassword" id="NewPassword" placeholder="Yeni şifrenizi giriniz" required>
                    </div>
                  </div>

                  <!-- Yeni Şifre Tekrar -->
                  <div class="form-group mb-20"> 
                    <label class="font-xs color-grey-900 d-block mb-8" style="font-weight: 600;">Yeni Şifre Tekrarı</label>
                    <div class="input-icon-group">
                      <div class="icon-inside">
                        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                      <input class="form-control" type="password" name="ConfirmPassword" id="ConfirmPassword" placeholder="Şifrenizi tekrar doğrulayınız" required>
                    </div>
                  </div>
                  
                  <div class="form-group mt-25"> 
                    <button class="btn btn-brand-1-big btn-submit-reset" type="submit">
                      <span>Şifreyi Güncelle</span>
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </button>
                  </div>
                  @Html.AntiForgeryToken()
                  <div class="d-flex align-items-center justify-content-between mt-20">
                    <a class="back-to-login" href="/Account/Login">
                      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                      </svg>
                      <span>Giriş Yap</span>
                    </a>
                    <a class="font-xs color-brand-2" href="/Account/ForgetPassword">Kodu almadınız mı? Yeniden Gönder</a>
                  </div>

                  <div class="secure-badge">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                    <span>256-Bit SSL ile Şifrelenmiş Güvenli Güncelleme</span>
                  </div>

                </form>
              </div>
            </div>
          </div>
          
          <div class="col-lg-6">
            <div class="box-login-right">
              <div class="quote-shape shape-1"></div>
              <div class="box-info-bottom-img box-info-bottom-img-3"> 
                <div class="image-play"><img class="mb-15" src="~/templates/assets/imgs/template/icons/play.svg" alt="transp"></div>
                <div class="info-play"> 
                  <h4 class="color-white mb-15">Hesap Güvenliği Standartları</h4>
                  <p class="font-sm color-white">Güçlü bir şifre seçerek hesabınızı ve verilerinizi güvende tutun. Şifrenizi kimseyle paylaşmayınız.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    
    <script src="~/templates/assets/js/vendors/modernizr-3.6.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery-3.6.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery-migrate-3.3.0.min.js"></script>
    <script src="~/templates/assets/js/vendors/bootstrap.bundle.min.js"></script>
    <script src="~/templates/assets/js/vendors/waypoints.js"></script>
    <script src="~/templates/assets/js/vendors/wow.js"></script>
    <script src="~/templates/assets/js/vendors/magnific-popup.js"></script>
    <script src="~/templates/assets/js/vendors/perfect-scrollbar.min.js"></script>
    <script src="~/templates/assets/js/vendors/select2.min.js"></script>
    <script src="~/templates/assets/js/vendors/isotope.js"></script>
    <script src="~/templates/assets/js/vendors/scrollup.js"></script>
    <script src="~/templates/assets/js/vendors/swiper-bundle.min.js"></script>
    <script src="~/templates/assets/js/vendors/noUISlider.js"></script>
    <script src="~/templates/assets/js/vendors/slider.js"></script>
    <script src="~/templates/assets/js/vendors/counterup.js"></script>
    <script src="~/templates/assets/js/vendors/jquery.countdown.min.js"></script>
    <script src="~/templates/assets/js/vendors/jquery.elevatezoom.js"></script>
    <script src="~/templates/assets/js/vendors/slick.js"></script>
    <script src="~/templates/assets/js/main.js?v=3.0.0"></script>

    <!-- 2 Dakika Geri Sayım Scripti -->
    <script>
      let duration = 120; // 2 dakika
      const display = document.getElementById("countdownTimer");
      
      const timer = setInterval(function () {
        let minutes = parseInt(duration / 60, 10);
        let seconds = parseInt(duration % 60, 10);

        minutes = minutes < 10 ? "0" + minutes : minutes;
        seconds = seconds < 10 ? "0" + seconds : seconds;

        display.textContent = minutes + ":" + seconds;

        if (--duration < 0) {
          clearInterval(timer);
          display.textContent = "Süre Doldu!";
          display.style.color = "#DC3545";
          display.style.borderColor = "#DC3545";
        }
      }, 1000);
    </script>
  </body>
</html>
