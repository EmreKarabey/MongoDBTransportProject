
@model Paginate<GetActiveListWhatWeHaveDoneDto>

<style>
    /* Neler Yaptık kartlarını eşit yüksekliğe getir */
    .swiper-group-4 .swiper-wrapper {
        align-items: stretch !important;
    }

    .swiper-group-4 .swiper-slide {
        height: auto !important;
        display: flex !important;
    }

    .swiper-group-4 .cardGrid {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        width: 100% !important;
    }

    .swiper-group-4 .cardGrid .cardImage {
        height: 200px !important;
        min-height: 200px !important;
        max-height: 200px !important;
        overflow: hidden !important;
        flex-shrink: 0 !important;
    }

    .swiper-group-4 .cardGrid .cardImage img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
    }

    .swiper-group-4 .cardGrid .cardInfo {
        flex: 1 !important;
        display: flex !important;
        flex-direction: column !important;
        min-height: 120px !important;
    }

    .swiper-group-4 .cardGrid .cardInfo p {
        flex: 1 !important;
    }
</style>

<section class="section bg-what-done pb-95 pt-110" id="projelerimiz">
    <div class="container">
        <h2 class="title-favicon mb-20">Neler Yaptık</h2>
        <div class="row align-items-end">
            <div class="col-lg-8 col-md-8 mb-30">
                <p class="font-md color-gray-700">Harika ortaklarımızla tamamladığımız bazı projelere göz atın.</p>
            </div>
           
        </div>
        <div class="mt-35">
            <div class="box-swiper">
                <div class="swiper-container swiper-group-4 pb-50">
                    <div class="swiper-wrapper">
                        @foreach (var item in Model.List)
                        {
                              <div class="swiper-slide">
                            <div class="cardGrid">
                                <div class="cardImage"> <img src="@item.ImageURL" alt="transp"></div>
                                <div class="cardInfo">
                                    <h5 class="color-brand-2 mb-10">@item.Title</h5>
                                    <p class="font-xs color-grey-500">@item.Description</p>
                                </div>
                            </div>
                        </div>
                        }
                      

                    </div>
                    <div class="box-pagination-customers text-center">
                        <div class="swiper-button-prev swiper-button-prev-style-1 swiper-button-prev-group-4">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                            </svg>
                        </div>
                        <div class="swiper-button-next swiper-button-next-style-1 swiper-button-next-group-4">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>










