
@model Paginate<GetActiveListFAQDto>

<section class="section pt-80 mb-70 bg-faqs">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="box-faqs-left">
                    <h2 class="title-favicon mb-20">Sıkça Sorulan Sorular ?</h2>
                    <p class="font-md color-grey-700 mb-50">Merak mı ediyorsunuz? Sıkça sorulan sorularımıza göz atın veya yardım için destek ekibimizle iletişime geçin</p>
                    <div class="box-gallery-faqs">
                        <div class="image-top"> <img src="~/templates/assets/imgs/page/homepage1/img-faq1.png" alt="transp"></div>
                        <div class="image-bottom">
                            <div class="image-faq-1"> <img src="~/templates/assets/imgs/page/homepage1/img-faq2.png" alt="transp"></div>
                            <div class="image-faq-2"> <img src="~/templates/assets/imgs/page/homepage1/img-faq3.png" alt="transp"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="box-accordion">
                    <div class="accordion" id="accordionFAQ">
                        @{ int faqIndex = 0; }
                        @foreach (var item in Model.List)
                        {
                            var collapseClass = faqIndex == 0 ? "collapse show" : "collapse";
                            var buttonClass = faqIndex == 0 ? "accordion-button text-heading-5" : "accordion-button text-heading-5 collapsed";
                            var isExpanded = faqIndex == 0 ? "true" : "false";

                            <div class="accordion-item">
                                <h5 class="accordion-header" id="heading-@item.FaqId">
                                    <button class="@buttonClass" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@item.FaqId" aria-expanded="@isExpanded" aria-controls="collapse-@item.FaqId">@item.Question</button>
                                </h5>
                                <div class="accordion-collapse @collapseClass" id="collapse-@item.FaqId" aria-labelledby="heading-@item.FaqId" data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">@item.Description</div>
                                </div>
                            </div>
                            faqIndex++;
                        }
                
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>