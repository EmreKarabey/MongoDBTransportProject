@model Paginate<Application.Features.Brand.Queries.GetActive.GetActiveListBrandDto>

<style>
    /* Logo hizalama düzeltmesi */
    .brand-logo-section .swiper-slide {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        height: 80px !important;
    }

    .brand-logo-section .swiper-slide img {
        max-height: 55px !important;
        max-width: 120px !important;
        width: auto !important;
        height: auto !important;
        object-fit: contain !important;
        vertical-align: middle !important;
    }

    .brand-logo-section .swiper-wrapper {
        align-items: center !important;
    }
</style>

<div class="section bg-2 pt-65 pb-35 brand-logo-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-3 mb-30 text-center text-lg-start">
                <p class="font-2xl-bold color-brand-2">Büyük küresel markalar bize <span class="color-brand-1">güveniyor</span></p>
            </div>
            <div class="col-lg-9 mb-30">
                <div class="box-swiper">
                    <div class="swiper-container swiper-group-6 pb-0">
                        <div class="swiper-wrapper">
                            @foreach (var item in Model.List)
                            {
                                <div class="swiper-slide"><img src="@item.ImageURL" alt="transp"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>